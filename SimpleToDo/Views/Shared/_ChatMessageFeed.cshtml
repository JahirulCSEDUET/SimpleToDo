@using SimpleToDo.Application.DTOs
@model List<ChatMessageDetailDto>

<style>
    .fb-chat-feed {
        --brand: #1F4D42;
        --brand-dark: #143229;
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --border-c: #E3E4DE;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .fb-bubble {
        max-width: 80%;
        padding: 9px 13px;
        font-size: 0.83rem;
        line-height: 1.45;
        word-break: break-word;
        border-radius: 14px;
    }

    .fb-bubble-me {
        background-color: var(--brand);
        color: #ffffff;
        align-self: flex-end;
        border-radius: 14px 14px 3px 14px;
    }

    .fb-bubble-other {
        background-color: var(--paper);
        border: 1px solid var(--border-c);
        color: var(--ink);
        align-self: flex-start;
        border-radius: 14px 14px 14px 3px;
    }

    .sender-tag {
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--brand);
        margin-bottom: 3px;
    }

    .msg-timestamp {
        font-size: 0.64rem;
        opacity: 0.75;
        margin-top: 3px;
    }

    .fb-chat-empty {
        text-align: center;
        padding: 40px 12px;
        color: var(--ink-soft);
        font-size: 0.86rem;
    }

        .fb-chat-empty i {
            font-size: 1.6rem;
            display: block;
            margin-bottom: 8px;
            color: var(--brand);
            opacity: 0.6;
        }
</style>

@if (Model == null || !Model.Any())
{
    <div class="fb-chat-empty">
        <i class="bi bi-chat-heart"></i>
        No messages yet. Send a greeting to start the conversation!
    </div>
}
else
{
    <div class="fb-chat-feed">
        @foreach (var message in Model)
        {
            if (message.IsMe)
            {
                <div class="fb-bubble fb-bubble-me shadow-none">
                    <div>@message.Body</div>
                    <div class="msg-timestamp text-end text-white-50">@message.FormattedTime</div>
                </div>
            }
            else
            {
                <div class="fb-bubble fb-bubble-other shadow-none">
                    <div class="sender-tag">@message.SenderName</div>
                    <div>@message.Body</div>
                    <div class="msg-timestamp text-muted">@message.FormattedTime</div>
                </div>
            }
        }
    </div>
}