@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuraSpace</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SimpleToDo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --brand: #1F4D42;
                --brand-dark: #143229;
                --brand-soft: #E7EEEA;
                --ink: #171B21;
                --ink-soft: #565F6B;
                --paper: #F7F7F4;
                --surface: #FFFFFF;
                --border-c: #E3E4DE;
                --rust: #A8501F;
                --gold: #B9862B;
                --slate: #3E5878;
            }

            body {
                background-color: var(--paper) !important;
                color: var(--ink);
            }

            .bg-primary {
                background-color: var(--brand) !important;
            }

            .text-primary {
                color: var(--brand) !important;
            }

            .border-primary {
                border-color: var(--brand) !important;
            }

            .bg-primary-subtle {
                background-color: var(--brand-soft) !important;
            }

            .border-primary-subtle {
                border-color: var(--brand-soft) !important;
            }

            .btn-primary {
                background-color: var(--brand);
                border-color: var(--brand);
            }

                .btn-primary:hover, .btn-primary:focus {
                    background-color: var(--brand-dark);
                    border-color: var(--brand-dark);
                }

            .btn-outline-primary {
                color: var(--brand);
                border-color: var(--brand);
            }

                .btn-outline-primary:hover {
                    background-color: var(--brand);
                    border-color: var(--brand);
                }

            .fb-dropdown-item {
                border-bottom: 1px solid var(--border-c);
                transition: background-color 0.15s ease;
                cursor: pointer;
                text-decoration: none;
                display: block;
            }

                .fb-dropdown-item:hover {
                    background-color: var(--paper);
                }

            .fb-unread-dot {
                width: 8px;
                height: 8px;
                background-color: var(--brand);
                border-radius: 50%;
                flex-shrink: 0;
            }

            .avatar-circle-sm {
                width: 38px;
                height: 38px;
                font-size: 0.85rem;
                font-weight: 600;
                flex-shrink: 0;
            }

            .text-muted-xs {
                font-size: 0.72rem;
                color: #8C9088;
            }

            .line-clamp-1 {
                display: -webkit-box;
                -webkit-line-clamp: 1;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .dropdown-title-group {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .dropdown-title-icon {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: var(--brand-soft);
                color: var(--brand);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.9rem;
                flex-shrink: 0;
            }

            .fb-chat-dock {
                position: fixed;
                bottom: 0;
                right: 24px;
                z-index: 1075;
                display: flex;
                align-items: flex-end;
                gap: 12px;
                pointer-events: none;
            }

            .fb-chat-box {
                width: 330px;
                background: var(--surface);
                border-radius: 14px 14px 0 0;
                box-shadow: 0 8px 24px rgba(23, 27, 33, 0.16);
                border: 1px solid var(--border-c);
                border-bottom: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                pointer-events: auto;
                animation: slideUpChat 0.2s ease-out;
            }

            @@keyframes slideUpChat {
                from {
                    transform: translateY(100%);
                    opacity: 0;
                }

                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            .fb-chat-header {
                background: var(--brand-dark);
                color: #ffffff;
                padding: 10px 14px;
                cursor: pointer;
            }

            .fb-chat-body {
                height: 310px;
                overflow-y: auto;
                padding: 12px;
                background-color: var(--paper);
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .fb-bubble {
                max-width: 80%;
                padding: 8px 12px;
                font-size: 0.82rem;
                line-height: 1.4;
                word-break: break-word;
            }

            .fb-bubble-me {
                background-color: var(--brand);
                color: #ffffff;
                align-self: flex-end;
                border-radius: 14px 14px 2px 14px;
            }

            .fb-bubble-other {
                background-color: var(--brand-soft);
                color: var(--ink);
                align-self: flex-start;
                border-radius: 14px 14px 14px 2px;
            }

            .fb-chat-footer {
                background: var(--surface);
                border-top: 1px solid var(--border-c);
                padding: 8px 10px;
            }

            /* ---------- Navbar ---------- */
            .app-navbar {
                background: var(--surface);
                border-bottom: 1px solid var(--border-c);
                padding: 14px 0;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
                font-size: 1.28rem;
                letter-spacing: -0.02em;
                color: var(--ink) !important;
                text-decoration: none;
            }

            .brand-mark {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: var(--brand);
                color: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
                flex-shrink: 0;
            }

            .nav-links {
                display: flex;
                align-items: center;
                gap: 4px;
                background: var(--paper);
                border: 1px solid var(--border-c);
                border-radius: 999px;
                padding: 4px;
            }

            .nav-link-custom {
                font-weight: 600;
                font-size: 0.86rem;
                color: var(--ink-soft);
                padding: 8px 16px;
                border-radius: 999px;
                text-decoration: none;
                transition: background 0.15s ease, color 0.15s ease;
                white-space: nowrap;
            }

                .nav-link-custom:hover {
                    color: var(--brand);
                }

                .nav-link-custom.active {
                    background: var(--surface);
                    color: var(--brand);
                    box-shadow: 0 1px 4px rgba(23, 27, 33, 0.08);
                }

            .user-chip {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--paper);
                border: 1px solid var(--border-c);
                border-radius: 999px;
                padding: 6px 14px 6px 8px;
                text-decoration: none;
                transition: border-color 0.15s ease, background 0.15s ease;
            }
            .user-chip:hover { background: var(--brand-soft); border-color: var(--brand-soft); }

            .user-chip-avatar {
                width: 26px;
                height: 26px;
                border-radius: 50%;
                background: var(--brand);
                color: #fff;
                font-size: 0.68rem;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .user-chip-name {
                font-size: 0.83rem;
                font-weight: 600;
                color: var(--ink);
            }
            .user-chip-greeting { font-size: 0.78rem; color: var(--ink-soft); }

            .fb-nav-btn {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--paper) !important;
                border: 1px solid var(--border-c) !important;
                color: var(--ink-soft);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
            }

                .fb-nav-btn i { color: var(--ink-soft) !important; font-size: 1.05rem; }

                .fb-nav-btn:hover {
                    background-color: var(--brand-soft) !important;
                    border-color: var(--brand-soft) !important;
                }
                .fb-nav-btn:hover i { color: var(--brand) !important; }

            .btn-logout-nav {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                border: none;
                background: transparent;
                color: var(--ink-soft);
                font-size: 0.86rem;
                font-weight: 600;
                padding: 8px 12px;
                border-radius: 999px;
                transition: color 0.15s ease, background 0.15s ease;
            }
            .btn-logout-nav:hover { color: #B23A3A; background: #F6DEDE; }

            .btn-register-nav {
                background: var(--brand);
                border: 1px solid var(--brand);
                color: #fff;
                font-weight: 600;
                font-size: 0.86rem;
                border-radius: 999px;
                padding: 8px 20px;
                text-decoration: none;
                transition: background 0.15s ease, transform 0.15s ease;
            }
            .btn-register-nav:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); }

            .btn-login-nav {
                color: var(--ink-soft);
                font-weight: 600;
                font-size: 0.86rem;
                padding: 8px 14px;
                text-decoration: none;
            }
            .btn-login-nav:hover { color: var(--brand); }

            @@media (max-width: 991px) {
                .nav-links {
                    flex-direction: column;
                    align-items: stretch;
                    border-radius: 14px;
                    gap: 2px;
                }
                .nav-link-custom { text-align: left; }
                .nav-link-custom.active { box-shadow: none; }
            }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-cloud-haze2"></i></span> AuraSpace
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-3 mb-lg-0 mt-3 mt-lg-0 list-unstyled nav-links">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-area="" asp-controller="Project" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-area="" asp-controller="ToDo" asp-action="Index">My Tasks</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2 list-unstyled d-flex flex-column flex-lg-row">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            
                            var navFullName = User.FindFirst("FullName")?.Value ?? "User";
                            var navInitial = !string.IsNullOrWhiteSpace(navFullName) ? navFullName.Trim()[0].ToString().ToUpper() : "U";
                            
                            <li class="nav-item me-lg-1 mb-2 mb-lg-0">
                                <a class="user-chip" asp-action="Index" asp-controller="User">
                                    <span class="user-chip-avatar">@navInitial</span>
                                    <span class="user-chip-greeting">Hello,</span>
                                    <span class="user-chip-name">@navFullName</span>
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <button type="button" class="btn fb-nav-btn position-relative p-0" id="fbMessageDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Messages">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span id="message-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary d-none" style="font-size: 0.65rem; padding: 0.25em 0.5em; transform: translate(-35%, -5%) !important;">
                                        0
                                    </span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 py-0 overflow-hidden mt-2" aria-labelledby="fbMessageDropdown" style="width: 360px; max-width: 90vw; z-index: 1050;">
                                    <div class="p-3 bg-white border-bottom d-flex align-items-center justify-content-between">
                                        <div class="dropdown-title-group">
                                            <span class="dropdown-title-icon"><i class="bi bi-chat-dots-fill"></i></span>
                                            <h5 class="mb-0 fw-bold text-dark fs-5" style="letter-spacing: -0.3px;">Messages</h5>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-subtle text-primary rounded-pill font-xs px-2 py-1" id="message-header-count">0 Unread</span>
                                        </div>
                                    </div>

                                    <div id="message-items-list" class="overflow-auto" style="max-height: 380px; background-color: #fff;">
                                        <div class="text-center py-4 text-muted small">Loading messages...</div>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item dropdown me-lg-2">
                                <button type="button" class="btn fb-nav-btn position-relative p-0" id="fbNotificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                    <i class="bi bi-bell-fill"></i>
                                    <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem; padding: 0.25em 0.5em; transform: translate(-35%, -5%) !important;">
                                        0
                                    </span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 py-0 overflow-hidden mt-2" aria-labelledby="fbNotificationDropdown" style="width: 360px; max-width: 90vw; z-index: 1050;">
                                    <div class="p-3 bg-white border-bottom d-flex align-items-center justify-content-between">
                                        <div class="dropdown-title-group">
                                            <span class="dropdown-title-icon"><i class="bi bi-bell-fill"></i></span>
                                            <h5 class="mb-0 fw-bold text-dark fs-5" style="letter-spacing: -0.3px;">Notifications</h5>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" id="mark-all-read-btn" class="btn btn-link btn-sm text-primary text-decoration-none p-0 small fw-medium" style="font-size: 0.82rem;">
                                                Mark all as read
                                            </button>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill font-xs px-2 py-1" id="notification-header-count">0 New</span>
                                        </div>
                                    </div>

                                    <div id="notification-items-list" class="overflow-auto" style="max-height: 380px; background-color: #fff;">
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                    <button type="submit" class="btn-logout-nav">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn-login-nav" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-register-nav" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5 flex-shrink-0">
        <main role="main" class="animation-fade-in">
            @RenderBody()
        </main>
    </div>

    <div id="fb-chat-dock" class="fb-chat-dock"></div>

    <footer class="footer mt-auto py-4 bg-white border-top border-light-subtle text-muted">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
            <div>
                &copy; 2026 <span class="fw-medium text-dark">AuraSpace</span>. All rights reserved.
            </div>
            <div class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted hover-primary">Privacy Policy</a>
                <span class="text-light-subtle">|</span>
                <span class="text-lowercase text-muted-opacity">Built with ASP.NET Core</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script src="~/js/notifications.js" asp-append-version="true"></script>
        <script src="~/js/messages.js" asp-append-version="true"></script>
        <script src="~/js/todo-board.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>