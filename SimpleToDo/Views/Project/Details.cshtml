@model SimpleToDo.Web.ViewModels.Project.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details - " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <span class="text-muted text-uppercase small fw-bold tracking-wide">Project Workspace</span>
        <h2 class="mb-0 fw-bold text-dark">@Model.Name</h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Back to Projects
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
        <ul class="nav nav-pills fs-6 fw-semibold" id="projectTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active px-4 rounded-pill" id="todos-tab" data-bs-toggle="tab" data-bs-target="#todos-pane" type="button" role="tab" aria-controls="todos-pane" aria-selected="true">
                    Todos
                    <span class="badge bg-secondary ms-2 rounded-pill">@Model.TodoList.Count</span>
                </button>
            </li>
            <li class="nav-item ms-2" role="presentation">
                <button class="nav-link px-4 rounded-pill" id="members-tab" data-bs-toggle="tab" data-bs-target="#members-pane" type="button" role="tab" aria-controls="members-pane" aria-selected="false">
                    Team Members
                    <span class="badge bg-secondary ms-2 rounded-pill">@Model.ProjectMemberList.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-0">
        <div class="tab-content" id="projectTabsContent">
            
            <div class="tab-pane fade show active" id="todos-pane" role="tabpanel" aria-labelledby="todos-tab">
                
                <div class="bg-light p-3 border-bottom border-top">
                    <form asp-controller="Todo" asp-action="QuickCreate" method="post" class="d-flex align-items-center gap-2 m-0 px-2">
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <input type="text" name="title" class="form-control rounded-pill border-secondary-subtle px-4" placeholder="What needs to be done? Type here..." required autocomplete="off" />
                        
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm text-nowrap">
                            + Add Task
                        </button>
                    </form>
                </div>

                @if (Model.TodoList.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4 w-50 border-0 pt-3 pb-3">Task Description</th>
                                    <th class="border-0 pt-3 pb-3">Created By</th>
                                    <th class="pe-4 text-end border-0 pt-3 pb-3">Assignment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var todo in Model.TodoList)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium text-dark py-3">@todo.Title</td>
                                        <td class="text-muted py-3">@todo.CreatedBy</td>
                                        <td class="pe-4 text-end py-3">
                                            @if (todo.UserId==null)
                                            {
                                                <a asp-controller="Todo" asp-action="Assign" asp-route-id="@todo.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    + Assign
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="d-inline-flex align-items-center bg-light rounded-pill px-3 py-1 border border-success-subtle">
                                                    <span class="text-success fw-semibold small">@todo.UserName</span>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="text-muted mb-3" style="font-size: 3rem;">📋</div>
                        <h5 class="fw-bold text-dark">No tasks yet</h5>
                        <p class="text-muted">Use the input field above to add the first task to this project.</p>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="members-pane" role="tabpanel" aria-labelledby="members-tab">
                
                <div class="d-flex justify-content-end p-3 bg-light border-bottom border-top">
                    <a asp-action="AddMember" asp-route-projectId="@Model.Id" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        + Add Member
                    </a>
                </div>

                @if (Model.ProjectMemberList.Any())
                {
                    <ul class="list-group list-group-flush rounded-bottom">
                        @foreach (var member in Model.ProjectMemberList)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight: 600;">
                                        @(string.IsNullOrEmpty(member.UserName) ? "?" : member.UserName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@member.UserName</div>
                                    </div>
                                </div>
                                
                                <div>
                                    <span class="badge @(member.Role.ToString() == "Admin" ? "bg-dark" : "bg-info text-dark") rounded-pill px-3 py-2 fw-medium">
                                        @member.Role
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="text-muted mb-3" style="font-size: 3rem;">👥</div>
                        <h5 class="fw-bold text-dark">No team members</h5>
                        <p class="text-muted">Invite people to collaborate on this project.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>