@model SimpleToDo.Web.ViewModels.Project.ProjectCreateViewModel

@{
    ViewData["Title"] = "Create Workspace";
}

<style>
    .create-page {
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --surface: #FFFFFF;
        --border-c: #E3E4DE;
        --brand: #1F4D42;
        --brand-dark: #143229;
        --brand-soft: #E7EEEA;
    }

        .create-page * {
            box-sizing: border-box;
        }

        .create-page h2, .create-page h5 {
            color: var(--ink);
        }

        .create-page .text-muted {
            color: var(--ink-soft) !important;
        }

    .create-header {
        border-bottom: 1px solid var(--border-c);
    }

    .back-circle {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--surface);
        border: 1px solid var(--border-c);
        color: var(--ink-soft);
        transition: all 0.15s ease;
    }

        .back-circle:hover {
            background: var(--brand-soft);
            border-color: var(--brand-soft);
            color: var(--brand);
        }

    .create-header h2 {
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .create-header p {
        font-size: 0.85rem;
        color: var(--ink-soft);
        margin: 0;
    }

    .create-card {
        background: var(--surface);
        border: 1px solid var(--border-c);
        border-radius: 20px;
        overflow: hidden;
    }

    .create-card-stripe {
        height: 4px;
        background: var(--brand);
        width: 100%;
    }

    .create-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--brand-soft);
        color: var(--brand);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .create-card h5 {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .create-card small {
        color: var(--ink-soft);
    }

    .field-label {
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 8px;
        display: block;
    }

    .input-wrap {
        display: flex;
        align-items: center;
        border: 1px solid var(--border-c);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        background: var(--surface);
    }

        .input-wrap:focus-within {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-soft);
        }

    .input-wrap-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        color: var(--ink-soft);
        background: var(--paper);
        border-right: 1px solid var(--border-c);
    }

    .input-wrap input {
        border: none;
        outline: none;
        box-shadow: none;
        padding: 11px 14px;
        font-size: 0.92rem;
        color: var(--ink);
        flex: 1;
        background: transparent;
    }

    .field-hint {
        font-size: 0.78rem;
        color: var(--ink-soft);
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .field-hint i {
            color: var(--brand);
        }

    .form-actions {
        border-top: 1px solid var(--border-c);
        padding-top: 22px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        background: var(--paper);
        color: var(--ink-soft);
        border: 1px solid var(--border-c);
        border-radius: 999px;
        padding: 9px 22px;
        font-size: 0.86rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s ease;
    }

        .btn-cancel:hover {
            background: var(--surface);
            color: var(--ink);
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--brand);
        color: #fff;
        border: 1px solid var(--brand);
        border-radius: 999px;
        padding: 9px 22px;
        font-size: 0.86rem;
        font-weight: 600;
        transition: background 0.15s ease, transform 0.15s ease;
    }

        .btn-submit:hover {
            background: var(--brand-dark);
            transform: translateY(-1px);
        }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
        font-size: 0.85rem;
    }

    .create-page .alert-danger {
        background: #F6DEDE;
        color: #A8501F;
        border-radius: 12px;
        border: none;
    }
</style>

<div class="create-page">
    <div class="container">
        <div class="create-header d-flex align-items-center gap-3 mb-5 pb-3 mt-4">
            <a asp-action="Index" class="back-circle" title="Back to Dashboard">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="mb-0">Create workspace</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-6 col-lg-8 mx-auto">

                <div class="create-card mb-4">
                    <div class="create-card-stripe"></div>

                    <div class="p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="create-card-icon"><i class="bi bi-folder-plus"></i></div>
                            <div>
                                <h5 class="mb-0">Workspace parameters</h5>
                                <small>Fill out the workspace specifications below.</small>
                            </div>
                        </div>

                        <form asp-action="Create" method="post" class="needs-validation">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-4" role="alert"></div>

                            <div class="form-group mb-4">
                                <label asp-for="Name" class="field-label">Workspace name</label>
                                <div class="input-wrap">
                                    <span class="input-wrap-icon"><i class="bi bi-pencil-square"></i></span>
                                    <input asp-for="Name" placeholder="Enter workspace name" autocomplete="off" required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1.5 d-block fw-medium"></span>
                            </div>

                            <div class="form-actions">
                                <a asp-action="Index" class="btn-cancel">Cancel</a>
                                <button type="submit" class="btn-submit">Initialize project <i class="bi bi-arrow-right"></i></button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}