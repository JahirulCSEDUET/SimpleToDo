@using SimpleToDo.Web.ViewModels.Project

@model IReadOnlyList<ProjectListViewModel>

@{
    ViewData["Title"] = "Projects Dashboard";

    var ownProjects = Model.Where(p => p.ProjectMembers
        .Any(m => m.UserId == p.CurrentUserId && m.Role.ToString() == "Admin"))
        .ToList();

    var contributions = Model.Where(p => p.ProjectMembers
        .Any(m => m.UserId == p.CurrentUserId && m.Role.ToString() == "Contributor"))
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
    <div>
        <h2 class="mb-1 fw-bold text-dark">Projects Dashboard</h2>
        <p class="text-muted mb-0 small">Manage your workspaces and team contributions</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm d-flex align-items-center gap-2">
        <span class="fs-5 lh-1">+</span> New Project
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 border-top border-4 border-primary rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="bg-primary bg-opacity-10 text-primary rounded px-2 py-1 fs-6">👑</span>
                    <h5 class="card-title mb-0 fw-bold">My Projects</h5>
                    <span class="badge bg-light text-secondary rounded-pill ms-auto border">@ownProjects.Count</span>
                </div>
            </div>
            
            <div class="card-body p-0">
                @if (ownProjects.Any())
                {
                    <div class="list-group list-group-flush rounded-bottom-4">
                        @foreach (var project in ownProjects)
                        {
                            <a asp-action="Details" asp-route-id="@project.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 border-bottom-0 border-top text-decoration-none">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light rounded text-secondary d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                                        <span class="fw-bold fs-5">@project.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@project.Name</h6>
                                        <small class="text-muted">Role: Admin</small>
                                    </div>
                                </div>
                                <span class="text-primary fw-medium small">
                                    Open &rarr;
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 px-4">
                        <div class="bg-light rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px;">
                            <span class="fs-3">📁</span>
                        </div>
                        <h6 class="fw-bold text-dark">No projects yet</h6>
                        <p class="text-muted small mb-4">You haven't created any projects as an Admin.</p>
                        <a asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill px-3">Create your first</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 border-top border-4 border-info rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="bg-info bg-opacity-10 text-info rounded px-2 py-1 fs-6">🤝</span>
                    <h5 class="card-title mb-0 fw-bold">Contributions</h5>
                    <span class="badge bg-light text-secondary rounded-pill ms-auto border">@contributions.Count</span>
                </div>
            </div>
            
            <div class="card-body p-0">
                @if (contributions.Any())
                {
                    <div class="list-group list-group-flush rounded-bottom-4">
                        @foreach (var project in contributions)
                        {
                            <a asp-action="Details" asp-route-id="@project.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-4 border-bottom-0 border-top text-decoration-none">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light rounded text-secondary d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                                        <span class="fw-bold fs-5">@project.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@project.Name</h6>
                                        <small class="text-muted">Role: Contributor</small>
                                    </div>
                                </div>
                                <span class="text-info fw-medium small">
                                    Open &rarr;
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 px-4">
                        <div class="bg-light rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px;">
                            <span class="fs-3">🌱</span>
                        </div>
                        <h6 class="fw-bold text-dark">No contributions yet</h6>
                        <p class="text-muted small mb-0">Projects you are invited to will appear here.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>