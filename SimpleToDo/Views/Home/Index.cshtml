@{
    ViewData["Title"] = "Platform Features & Overview";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<style>
    .explore-page {
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --surface: #FFFFFF;
        --border: #E3E4DE;
        --brand: #1F4D42;
        --brand-dark: #143229;
        --brand-soft: #E7EEEA;
        --rust: #A8501F;
        --rust-soft: #F3E4D8;
        --gold: #B9862B;
        --gold-soft: #F3E9D3;
        --slate: #3E5878;
        --slate-soft: #E5EAF1;
        --font-head: 'Space Grotesk', sans-serif;
        --font-body: 'Inter', sans-serif;
        --font-mono: 'IBM Plex Mono', monospace;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        padding: 48px 24px 80px;
        position: relative;
    }

        .explore-page * {
            box-sizing: border-box;
        }

        .explore-page h1, .explore-page h2, .explore-page h3 {
            font-family: var(--font-head);
            color: var(--ink);
            margin: 0;
        }

        .explore-page p {
            color: var(--ink-soft);
            margin: 0;
        }

    .explore-inner {
        max-width: 1080px;
        margin: 0 auto;
    }

    /* ---------- Scroll progress ---------- */
    .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0%;
        background: var(--brand);
        z-index: 9999;
        transition: width 0.08s linear;
    }

    /* ---------- Hero ---------- */
    .hero {
        background: var(--brand-);
        border-radius: 28px;
        overflow: hidden;
        margin-bottom: 48px;
    }

    .hero-inner {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 32px;
        padding: 56px;
    }

    .hero-copy h1 {
        font-size: 2.6rem;
        line-height: 1.12;
        letter-spacing: -0.01em;
        color: black;
        max-width: 460px;
    }

    .hero-copy p {
        color: #C7D2CB;
        font-size: 1.02rem;
        line-height: 1.6;
        max-width: 440px;
        margin-top: 18px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 30px;
    }

    .btn-solid, .btn-ghost {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.94rem;
        padding: 12px 24px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }

    .btn-solid {
        background: #EFE7D8;
        color: var(--brand-dark);
        border: 1px solid #EFE7D8;
    }

        .btn-solid:hover {
            background: #FFFFFF;
            transform: translateY(-1px);
        }

    .btn-ghost {
        background: Black;
        color: white;
        border: 1px solid rgba(237, 239, 234, 0.35);
    }

        .btn-ghost:hover {
            border-color: rgba(237, 239, 234, 0.7);
            transform: translateY(-1px);
        }

    
    .hero-board {
        background: rgba(251, 250, 246, 0.06);
        border: 1px solid rgba(251, 250, 246, 0.14);
        border-radius: 20px;
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .hero-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 210px;
    }

    .hero-col-label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: black;
        letter-spacing: 0.02em;
        padding-bottom: 4px;
    }

    .hero-card {
        background: #FBFAF6;
        border-radius: 10px;
        padding: 10px 11px;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--ink);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .hero-card.ghost {
            background: transparent;
            border: 1.5px dashed rgba(251, 250, 246, 0.22);
            box-shadow: none;
            min-height: 40px;
        }

        .hero-card .tag {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.62rem;
            color: var(--brand);
            background: var(--brand-soft);
            border-radius: 5px;
            padding: 2px 6px;
            margin-bottom: 6px;
        }

    @@media (max-width: 860px) {
        .hero-inner {
            grid-template-columns: 1fr;
            padding: 36px 24px;
        }

        .hero-copy h1 {
            font-size: 2.05rem;
            max-width: none;
        }

        .hero-copy p {
            max-width: none;
        }
    }

    
    .stats-strip {
        display: flex;
        gap: 20px;
        margin-bottom: 64px;
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.55s ease, transform 0.55s ease;
    }

        .stats-strip.in-view {
            opacity: 1;
            transform: translateY(0);
        }

    .stat-item {
        flex: 1;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px 18px;
        text-align: center;
    }

    .stat-num {
        font-family: var(--font-head);
        font-size: 1.9rem;
        font-weight: 700;
        color: var(--brand);
        letter-spacing: -0.01em;
    }

    .stat-label {
        font-size: 0.82rem;
        color: var(--ink-soft);
        margin-top: 6px;
    }

    @@media (max-width: 700px) {
        .stats-strip {
            flex-direction: column;
        }
    }

    
    .explorer-heading {
        margin-bottom: 28px;
    }

        .explorer-heading h2 {
            font-size: 1.6rem;
        }

        .explorer-heading p {
            margin-top: 8px;
            max-width: 520px;
        }

    .feature-explorer {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 40px;
        margin-bottom: 72px;
    }

    .feature-index {
        position: sticky;
        top: 24px;
        align-self: start;
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-left: 2px solid var(--border);
        padding-left: 4px;
    }

    .index-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        font-size: 0.86rem;
        font-weight: 500;
        color: var(--ink-soft);
        text-decoration: none;
        border-left: 2px solid transparent;
        margin-left: -6px;
        transition: color 0.15s ease, border-color 0.15s ease;
    }

        .index-item .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
            transition: background 0.15s ease;
        }

        .index-item:hover {
            color: var(--ink);
        }

        .index-item.active {
            color: var(--ink);
            font-weight: 600;
            border-left-color: var(--brand);
        }

            .index-item.active .dot {
                background: var(--brand);
            }

    .feature-panels {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .feature-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 36px;
        scroll-margin-top: 24px;
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.55s ease, transform 0.55s ease;
    }

        .feature-panel.in-view {
            opacity: 1;
            transform: translateY(0);
        }

    @@media (prefers-reduced-motion: reduce) {
        .feature-panel, .stats-strip {
            transition: none !important;
        }
    }

    .panel-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 36px;
        align-items: center;
    }

    .panel-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 4px 10px;
        border-radius: 6px;
        margin-bottom: 14px;
    }

        .panel-tag.brand {
            background: var(--brand-soft);
            color: var(--brand);
        }

        .panel-tag.rust {
            background: var(--rust-soft);
            color: var(--rust);
        }

        .panel-tag.gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .panel-tag.slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

    .feature-panel h3 {
        font-size: 1.28rem;
        margin-bottom: 10px;
    }

    .feature-panel > .panel-grid > div:first-child p.lede {
        font-size: 0.96rem;
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .point-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .point-list li {
            display: flex;
            gap: 10px;
            font-size: 0.87rem;
            color: var(--ink-soft);
            line-height: 1.5;
        }

            .point-list li strong {
                color: var(--ink);
            }

        .point-list i {
            color: var(--brand);
            margin-top: 3px;
            flex-shrink: 0;
        }

    .panel-visual {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px;
        min-height: 190px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .mock-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 14px;
        transition: border-color 0.2s ease;
    }

        .mock-card.accent-brand {
            border-left: 3px solid var(--brand);
        }

        .mock-card.accent-rust {
            border-left: 3px solid var(--rust);
        }

        .mock-card.accent-slate {
            border-left: 3px solid var(--slate);
        }

    .mock-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .mock-title {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ink);
    }

    .mock-sub {
        font-size: 0.68rem;
        color: var(--ink-soft);
        font-family: var(--font-mono);
    }

    .avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.66rem;
        font-weight: 700;
        color: var(--brand);
        background: var(--brand-soft);
        flex-shrink: 0;
    }

    .pill {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        padding: 2px 8px;
        border-radius: 999px;
    }

        .pill.brand {
            background: var(--brand-soft);
            color: var(--brand);
        }

        .pill.gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .pill.slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

        .pill.rust {
            background: var(--rust-soft);
            color: var(--rust);
        }

    button.chip {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        padding: 4px 9px;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--ink-soft);
        background: transparent;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

        button.chip:hover {
            border-color: var(--brand);
            color: var(--brand);
        }

        button.chip.on {
            background: var(--ink);
            color: #fff;
            border-color: var(--ink);
        }

    .bubble {
        font-size: 0.76rem;
        border-radius: 14px;
        padding: 7px 12px;
        max-width: 82%;
    }

        .bubble.in {
            background: var(--surface);
            border: 1px solid var(--border);
            align-self: flex-start;
            color: var(--ink-soft);
        }

        .bubble.out {
            background: var(--brand);
            color: #fff;
            align-self: flex-end;
        }

            .bubble.out.fade-in {
                animation: bubbleFadeIn 0.35s ease;
            }

    @@keyframes bubbleFadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .typing-dots {
        display: inline-flex;
        align-self: flex-start;
        gap: 4px;
        padding: 9px 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
    }

        .typing-dots span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--ink-soft);
            opacity: 0.4;
            animation: typingBounce 1s infinite ease-in-out;
        }

            .typing-dots span:nth-child(2) {
                animation-delay: 0.15s;
            }

            .typing-dots span:nth-child(3) {
                animation-delay: 0.3s;
            }

    @@keyframes typingBounce {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        30% {
            transform: translateY(-4px);
            opacity: 1;
        }
    }

    .skeleton-line {
        height: 6px;
        border-radius: 4px;
        margin-bottom: 6px;
        background: linear-gradient(90deg, var(--paper) 25%, #EDEEE9 37%, var(--paper) 63%);
        background-size: 400% 100%;
        animation: shimmer 1.4s ease infinite;
    }

    @@keyframes shimmer {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0 50%;
        }
    }

    .notif-content {
        display: none;
    }

        .notif-content.show {
            display: block;
            animation: bubbleFadeIn 0.4s ease;
        }

    @@media (max-width: 900px) {
        .feature-explorer {
            grid-template-columns: 1fr;
        }

        .feature-index {
            position: static;
            flex-direction: row;
            flex-wrap: wrap;
            border-left: none;
            border-bottom: 1px solid var(--border);
            padding-bottom: 14px;
            gap: 8px;
        }

        .index-item {
            border-left: none;
            margin-left: 0;
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid var(--border);
        }

            .index-item.active {
                background: var(--brand-soft);
                border-color: var(--brand-soft);
            }

        .panel-grid {
            grid-template-columns: 1fr;
        }

        .feature-panel {
            padding: 26px;
        }
    }

    .cta-section {
        border-top: 1px solid var(--border);
        padding-top: 56px;
    }

    .cta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .cta-block {
        border-radius: 20px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 22px;
        min-height: 220px;
    }

        .cta-block.signin {
            background: var(--surface);
            border: 1px solid var(--border);
        }

        .cta-block.register {
            background: var(--brand-dark);
        }

        .cta-block h4 {
            font-size: 1.15rem;
        }

        .cta-block.register h4 {
            color: #FBFAF6;
        }

        .cta-block.signin p, .cta-block.register p {
            font-size: 0.88rem;
            line-height: 1.55;
        }

        .cta-block.register p {
            color: #C7D2CB;
        }

        .cta-block .btn-solid, .cta-block .btn-ghost {
            align-self: flex-start;
        }

    .btn-outline-ink {
        font-weight: 600;
        font-size: 0.9rem;
        padding: 11px 22px;
        border-radius: 999px;
        border: 1px solid var(--ink);
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s ease, color 0.15s ease;
    }

        .btn-outline-ink:hover {
            background: var(--ink);
            color: #fff;
        }

    .welcome-block {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        max-width: 560px;
        margin: 0 auto;
    }

        .welcome-block h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
        }

        .welcome-block p {
            margin-bottom: 22px;
        }

    @@media (max-width: 700px) {
        .cta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="scroll-progress" id="scrollProgress"></div>

<div class="explore-page">
    <div class="explore-inner">

        
        <section class="hero">
            <div class="hero-inner">
                <div class="hero-copy">
                    <h1>Designed to keep your team moving</h1>
                    <p>Eliminate project chaos with visual workflow tracking, direct task query discussions, and instant team communication in one clean workspace.</p>
                    <div class="hero-actions">
                        @if (isAuthenticated)
                        {
                            <a asp-controller="Project" asp-action="Index" class="btn-solid">
                                <i class="bi bi-kanban"></i> Manage workspaces
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn-solid">
                                Get started <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn-ghost">
                                Sign in
                            </a>
                        }
                    </div>
                </div>

                <div class="hero-board" id="heroBoard" aria-hidden="true">
                    <div class="hero-col">
                        <span class="hero-col-label">TODO · 2</span>
                        <div class="hero-card" id="heroCard1">
                            <span class="tag">WEB-14</span><br>
                            Drag &amp; drop board polish
                        </div>
                        <div class="hero-card">
                            <span class="tag">WEB-09</span><br>
                            Notification badges
                        </div>
                    </div>
                    <div class="hero-col" id="heroColProgress">
                        <span class="hero-col-label">IN PROGRESS · 1</span>
                        <div class="hero-card">
                            <span class="tag">WEB-11</span><br>
                            Workspace member roster
                        </div>
                        <div class="hero-card ghost" id="heroGhost"></div>
                    </div>
                    <div class="hero-col">
                        <span class="hero-col-label">DONE · 1</span>
                        <div class="hero-card">
                            <span class="tag">WEB-02</span><br>
                            Project chat window
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats strip -->
        <section class="stats-strip" id="statsStrip">
            <div class="stat-item">
                <div class="stat-num" data-target="128" data-suffix="+">0</div>
                <div class="stat-label">Active workspaces</div>
            </div>
            <div class="stat-item">
                <div class="stat-num" data-target="4300" data-suffix="+">0</div>
                <div class="stat-label">Tasks completed</div>
            </div>
            <div class="stat-item">
                <div class="stat-num" data-target="99.9" data-suffix="%" data-decimal="1">0</div>
                <div class="stat-label">Uptime</div>
            </div>
        </section>

        <!-- Feature explorer -->
        <div class="explorer-heading">
            <h2>Everything a workspace needs</h2>
            <p>Seven tools that work together, from how you organize a team to how a single task gets discussed and closed out.</p>
        </div>

        <div class="feature-explorer">
            <nav class="feature-index" id="featureIndex">
                <a href="#f-workspaces" class="index-item"><span class="dot"></span>Workspaces &amp; teams</a>
                <a href="#f-filter" class="index-item"><span class="dot"></span>Filter by member</a>
                <a href="#f-mytasks" class="index-item"><span class="dot"></span>Unified my tasks</a>
                <a href="#f-chat" class="index-item"><span class="dot"></span>Team messenger</a>
                <a href="#f-notifications" class="index-item"><span class="dot"></span>Live notifications</a>
                <a href="#f-discussions" class="index-item"><span class="dot"></span>Task discussions</a>
                <a href="#f-archive" class="index-item"><span class="dot"></span>Archiving</a>
            </nav>

            <div class="feature-panels">

                <!-- Workspaces & Team Management -->
                <article id="f-workspaces" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Team hub</span>
                            <h3>Dedicated workspaces &amp; team management</h3>
                            <p class="lede">Organize work by initiative, department, or client into isolated workspaces, and bring team members together with clear access and direct delegation.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span><strong>Member roster:</strong> add teammates to a workspace so everyone knows who's on it.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Project boundary:</strong> keep documents, conversations, and task lists private to designated members.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Direct assignment:</strong> assign owners to deliverables so accountability stays clear.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-card">
                                <div class="mock-row" style="margin-bottom:10px;">
                                    <span class="mock-title"><i class="bi bi-diagram-3-fill" style="color:var(--brand); margin-right:6px;"></i>Workspace</span>
                                    <span class="pill brand">5 members</span>
                                </div>
                                <div class="mock-row" style="margin-bottom:8px;">
                                    <div class="mock-row" style="gap:8px;"><div class="avatar">JD</div><span class="mock-sub">Lead Dev</span></div>
                                    <span class="pill brand">Active</span>
                                </div>
                                <div class="mock-row">
                                    <div class="mock-row" style="gap:8px;"><div class="avatar" style="color:var(--slate); background:var(--slate-soft);">SK</div><span class="mock-sub">Product Lead</span></div>
                                    <span class="pill slate">Member</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Filter by member (now interactive) -->
                <article id="f-filter" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Member focus</span>
                            <h3>Workspace filtering by team member</h3>
                            <p class="lede">Isolate individual workloads in a single click — filter the board by teammate to check progress, balance workload, or focus only on what's yours. Try it below.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span><strong>One-click isolation:</strong> filter board tasks to show only work assigned to a chosen collaborator.</span></li>
