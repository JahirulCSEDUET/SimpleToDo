        <section class="cta-section">
            @if (!isAuthenticated)
            {
                <div class="explorer-heading">
                    <h2>Ready to simplify your daily workflow?</h2>
                    <p>Access your existing account, or register in seconds.</p>
                </div>

                <div class="cta-grid">
                    <div class="cta-block signin">
                        <div>
                            <h4>Sign in</h4>
                            <p>Continue managing your active tasks, discussions, and project messages.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn-outline-ink">
                            Enter workspace <i class="bi bi-box-arrow-in-right"></i>
                        </a>
                    </div>

                    <div class="cta-block register">
                        <div>
                            <h4>Create an account</h4>
                            <p>Set up your profile to start creating projects, organizing tasks, and collaborating with teammates.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Register" class="btn-solid">
                            Get started <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="welcome-block">
                    <h4>Welcome back, @User.Identity?.Name</h4>
                    <p>Head straight to your dashboard to review your active priorities.</p>
                    <a asp-controller="Project" asp-action="Index" class="btn-outline-ink">
                        Go to dashboard <i class="bi bi-arrow-right-circle"></i>
                    </a>
                </div>
            }
        </section>

    </div>
</div>

<script>
    (function() {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        
        var progressBar = document.getElementById('scrollProgress');
        function updateProgress() {
            var scrollTop = window.scrollY || document.documentElement.scrollTop;
            var docHeight = document.documentElement.scrollHeight - window.innerHeight;
            var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            progressBar.style.width = pct + '%';
        }
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        
        var indexLinks = Array.prototype.slice.call(document.querySelectorAll('#featureIndex .index-item'));
        var panels = Array.prototype.slice.call(document.querySelectorAll('.feature-panel'));

        if (panels.length && 'IntersectionObserver' in window) {
            var navObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        var id = entry.target.getAttribute('id');
                        indexLinks.forEach(function(link) {
                            link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                        });
                    }
                });
            }, { rootMargin: '-20% 0px -65% 0px', threshold: 0 });

            panels.forEach(function(panel) { navObserver.observe(panel); });
        } else if (indexLinks[0]) {
            indexLinks[0].classList.add('active');
        }

        indexLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                var target = document.querySelector(link.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                }
            });
        });

        
        function animateCounter(el) {
            var target = parseFloat(el.getAttribute('data-target'));
            var decimals = parseInt(el.getAttribute('data-decimal') || '0', 10);
            var suffix = el.getAttribute('data-suffix') || '';
            var duration = 1100;
            var startTime = null;
            function step(ts) {
                if (!startTime) startTime = ts;
                var progress = Math.min((ts - startTime) / duration, 1);
                el.textContent = (target * progress).toFixed(decimals) + suffix;
                if (progress < 1) requestAnimationFrame(step);
                else el.textContent = target.toFixed(decimals) + suffix;
            }
            requestAnimationFrame(step);
        }

        function startCounters() {
            document.querySelectorAll('.stat-num').forEach(function(el) {
                if (reduceMotion) {
                    var t = parseFloat(el.getAttribute('data-target'));
                    var d = parseInt(el.getAttribute('data-decimal') || '0', 10);
                    el.textContent = t.toFixed(d) + (el.getAttribute('data-suffix') || '');
                } else {
                    animateCounter(el);
                }
            });
        }

        
        function startChatDemo() {
            var typing = document.getElementById('chatTyping');
            var reply = document.getElementById('chatReply');
            if (!typing || !reply) return;
            if (reduceMotion) {
                typing.style.display = 'none';
                reply.style.display = 'block';
                return;
            }
            setTimeout(function() {
                typing.style.display = 'none';
                reply.style.display = 'block';
                reply.classList.add('fade-in');
            }, 900);
        }

        
        function startNotifDemo() {
            var skeleton = document.getElementById('notifSkeleton');
            var content = document.getElementById('notifContent');
            if (!skeleton || !content) return;
            if (reduceMotion) {
                skeleton.style.display = 'none';
                content.classList.add('show');
                return;
            }
            setTimeout(function() {
                skeleton.style.display = 'none';
                content.classList.add('show');
            }, 1100);
        }

        
        var revealTargets = document.querySelectorAll('.feature-panel, #statsStrip');
        if ('IntersectionObserver' in window) {
            var revealObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        var id = entry.target.getAttribute('id');
                        if (id === 'f-chat') startChatDemo();
                        if (id === 'f-notifications') startNotifDemo();
                        if (id === 'statsStrip') startCounters();
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });

            revealTargets.forEach(function(el) { revealObserver.observe(el); });
        } else {
            revealTargets.forEach(function(el) { el.classList.add('in-view'); });
            startCounters();
            startChatDemo();
            startNotifDemo();
        }

        
        var filterData = {
            all: { label: 'All tasks', title: '12 tasks across the board', accent: 'slate', pillClass: 'slate' },
            alex: { label: 'Assigned to Alex', title: 'Implement payment gateway tests', accent: 'brand', pillClass: 'brand' },
            sarah: { label: 'Assigned to Sarah', title: 'Review onboarding flow copy', accent: 'rust', pillClass: 'rust' }
        };
        var chipButtons = Array.prototype.slice.call(document.querySelectorAll('#filterChips .chip'));
        var resultCard = document.getElementById('filterResultCard');
        var resultLabel = document.getElementById('filterResultLabel');
        var resultTitle = document.getElementById('filterResultTitle');

        chipButtons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                chipButtons.forEach(function(b) { b.classList.remove('on'); });
                btn.classList.add('on');

                var data = filterData[btn.getAttribute('data-name')];
                if (!data || !resultCard) return;

                resultCard.classList.remove('accent-brand', 'accent-rust', 'accent-slate');
                resultCard.classList.add('accent-' + data.accent);
                resultLabel.className = 'pill ' + data.pillClass;
                resultLabel.textContent = data.label;
                resultTitle.textContent = data.title;
            });
        });

        
        if (!reduceMotion) {
            var card = document.getElementById('heroCard1');
            var ghost = document.getElementById('heroGhost');
            if (card && ghost) {
                setTimeout(function() {
                    var cardRect = card.getBoundingClientRect();
                    var ghostRect = ghost.getBoundingClientRect();
                    var dx = ghostRect.left - cardRect.left;
                    var dy = ghostRect.top - cardRect.top;
                    card.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
                    card.style.opacity = '0';
                    setTimeout(function() {
                        ghost.classList.remove('ghost');
                        ghost.innerHTML = card.innerHTML;
                        card.style.display = 'none';
                    }, 620);
                }, 1400);
            }
        }
    })();
</script>