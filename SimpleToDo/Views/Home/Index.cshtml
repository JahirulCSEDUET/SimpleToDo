@{
    ViewData["Title"] = "Platform Features & Overview";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<style>
    
    .explore-page {
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --surface: #FFFFFF;
        --border: #E3E4DE;
        --brand: #1F4D42;
        --brand-dark: #143229;
        --brand-soft: #E7EEEA;
        --rust: #A8501F;
        --rust-soft: #F3E4D8;
        --gold: #B9862B;
        --gold-soft: #F3E9D3;
        --slate: #3E5878;
        --slate-soft: #E5EAF1;
        --font-head: 'Space Grotesk', sans-serif;
        --font-body: 'Inter', sans-serif;
        --font-mono: 'IBM Plex Mono', monospace;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        padding: 48px 24px 80px;
    }

        .explore-page * {
            box-sizing: border-box;
        }

        .explore-page h1, .explore-page h2, .explore-page h3 {
            font-family: var(--font-head);
            color: var(--ink);
            margin: 0;
        }

        .explore-page p {
            color: var(--ink-soft);
            margin: 0;
        }

    .explore-inner {
        max-width: 1080px;
        margin: 0 auto;
    }

    /* ---------- Hero ---------- */
    .hero {
        background: var(--brand-dark);
        border-radius: 28px;
        overflow: hidden;
        margin-bottom: 64px;
    }

    .hero-inner {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 32px;
        padding: 56px;
    }

    .hero-copy h1 {
        font-size: 2.6rem;
        line-height: 1.12;
        letter-spacing: -0.01em;
        color: #FBFAF6;
        max-width: 460px;
    }

    .hero-copy p {
        color: #C7D2CB;
        font-size: 1.02rem;
        line-height: 1.6;
        max-width: 440px;
        margin-top: 18px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 30px;
    }

    .btn-solid, .btn-ghost {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.94rem;
        padding: 12px 24px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }

    .btn-solid {
        background: #EFE7D8;
        color: var(--brand-dark);
        border: 1px solid #EFE7D8;
    }

        .btn-solid:hover {
            background: #FFFFFF;
            transform: translateY(-1px);
        }

    .btn-ghost {
        background: transparent;
        color: #EDEFEA;
        border: 1px solid rgba(237, 239, 234, 0.35);
    }

        .btn-ghost:hover {
            border-color: rgba(237, 239, 234, 0.7);
            transform: translateY(-1px);
        }

    /* Mini kanban hero visual */
    .hero-board {
        background: rgba(251, 250, 246, 0.06);
        border: 1px solid rgba(251, 250, 246, 0.14);
        border-radius: 20px;
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .hero-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 210px;
    }

    .hero-col-label {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: #A9B8AE;
        letter-spacing: 0.02em;
        padding-bottom: 4px;
    }

    .hero-card {
        background: #FBFAF6;
        border-radius: 10px;
        padding: 10px 11px;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--ink);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .hero-card.ghost {
            background: transparent;
            border: 1.5px dashed rgba(251, 250, 246, 0.22);
            box-shadow: none;
            min-height: 40px;
        }

        .hero-card .tag {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.62rem;
            color: var(--brand);
            background: var(--brand-soft);
            border-radius: 5px;
            padding: 2px 6px;
            margin-bottom: 6px;
        }

    @@media (max-width: 860px) {
        .hero-inner {
            grid-template-columns: 1fr;
            padding: 36px 24px;
        }

        .hero-copy h1 {
            font-size: 2.05rem;
            max-width: none;
        }

        .hero-copy p {
            max-width: none;
        }
    }

    /* ---------- Feature explorer ---------- */
    .explorer-heading {
        margin-bottom: 28px;
    }

        .explorer-heading h2 {
            font-size: 1.6rem;
        }

        .explorer-heading p {
            margin-top: 8px;
            max-width: 520px;
        }

    .feature-explorer {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 40px;
        margin-bottom: 72px;
    }

    .feature-index {
        position: sticky;
        top: 24px;
        align-self: start;
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-left: 2px solid var(--border);
        padding-left: 4px;
    }

    .index-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        font-size: 0.86rem;
        font-weight: 500;
        color: var(--ink-soft);
        text-decoration: none;
        border-left: 2px solid transparent;
        margin-left: -6px;
        transition: color 0.15s ease, border-color 0.15s ease;
    }

        .index-item .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--border);
            flex-shrink: 0;
            transition: background 0.15s ease;
        }

        .index-item:hover {
            color: var(--ink);
        }

        .index-item.active {
            color: var(--ink);
            font-weight: 600;
            border-left-color: var(--brand);
        }

            .index-item.active .dot {
                background: var(--brand);
            }

    .feature-panels {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .feature-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 36px;
        scroll-margin-top: 24px;
    }

    .panel-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 36px;
        align-items: center;
    }

    .panel-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 4px 10px;
        border-radius: 6px;
        margin-bottom: 14px;
    }

        .panel-tag.brand {
            background: var(--brand-soft);
            color: var(--brand);
        }

        .panel-tag.rust {
            background: var(--rust-soft);
            color: var(--rust);
        }

        .panel-tag.gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .panel-tag.slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

    .feature-panel h3 {
        font-size: 1.28rem;
        margin-bottom: 10px;
    }

    .feature-panel > .panel-grid > div:first-child p.lede {
        font-size: 0.96rem;
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .point-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .point-list li {
            display: flex;
            gap: 10px;
            font-size: 0.87rem;
            color: var(--ink-soft);
            line-height: 1.5;
        }

            .point-list li strong {
                color: var(--ink);
            }

        .point-list i {
            color: var(--brand);
            margin-top: 3px;
            flex-shrink: 0;
        }

    .panel-visual {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px;
        min-height: 190px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
    }

    .mock-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 14px;
    }

        .mock-card.accent-brand {
            border-left: 3px solid var(--brand);
        }

        .mock-card.accent-rust {
            border-left: 3px solid var(--rust);
        }

        .mock-card.accent-slate {
            border-left: 3px solid var(--slate);
        }

    .mock-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .mock-title {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ink);
    }

    .mock-sub {
        font-size: 0.68rem;
        color: var(--ink-soft);
        font-family: var(--font-mono);
    }

    .avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.66rem;
        font-weight: 700;
        color: var(--brand);
        background: var(--brand-soft);
        flex-shrink: 0;
    }

    .pill {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        padding: 2px 8px;
        border-radius: 999px;
    }

        .pill.brand {
            background: var(--brand-soft);
            color: var(--brand);
        }

        .pill.gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .pill.slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

    .chip {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        padding: 4px 9px;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--ink-soft);
    }

        .chip.on {
            background: var(--ink);
            color: #fff;
            border-color: var(--ink);
        }

    .bubble {
        font-size: 0.76rem;
        border-radius: 14px;
        padding: 7px 12px;
        max-width: 82%;
    }

        .bubble.in {
            background: var(--surface);
            border: 1px solid var(--border);
            align-self: flex-start;
            color: var(--ink-soft);
        }

        .bubble.out {
            background: var(--brand);
            color: #fff;
            align-self: flex-end;
        }

    @@media (max-width: 900px) {
        .feature-explorer {
            grid-template-columns: 1fr;
        }

        .feature-index {
            position: static;
            flex-direction: row;
            flex-wrap: wrap;
            border-left: none;
            border-bottom: 1px solid var(--border);
            padding-bottom: 14px;
            gap: 8px;
        }

        .index-item {
            border-left: none;
            margin-left: 0;
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid var(--border);
        }

            .index-item.active {
                background: var(--brand-soft);
                border-color: var(--brand-soft);
            }

        .panel-grid {
            grid-template-columns: 1fr;
        }

        .feature-panel {
            padding: 26px;
        }
    }

    /* ---------- CTA ---------- */
    .cta-section {
        border-top: 1px solid var(--border);
        padding-top: 56px;
    }

    .cta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .cta-block {
        border-radius: 20px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 22px;
        min-height: 220px;
    }

        .cta-block.signin {
            background: var(--surface);
            border: 1px solid var(--border);
        }

        .cta-block.register {
            background: var(--brand-dark);
        }

        .cta-block h4 {
            font-size: 1.15rem;
        }

        .cta-block.register h4 {
            color: #FBFAF6;
        }

        .cta-block.signin p, .cta-block.register p {
            font-size: 0.88rem;
            line-height: 1.55;
        }

        .cta-block.register p {
            color: #C7D2CB;
        }

        .cta-block .btn-solid, .cta-block .btn-ghost {
            align-self: flex-start;
        }

    .btn-outline-ink {
        font-weight: 600;
        font-size: 0.9rem;
        padding: 11px 22px;
        border-radius: 999px;
        border: 1px solid var(--ink);
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s ease, color 0.15s ease;
    }

        .btn-outline-ink:hover {
            background: var(--ink);
            color: #fff;
        }

    .welcome-block {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        max-width: 560px;
        margin: 0 auto;
    }

        .welcome-block h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
        }

        .welcome-block p {
            margin-bottom: 22px;
        }

    @@media (max-width: 700px) {
        .cta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="explore-page">
    <div class="explore-inner">

        <!-- Hero -->
        <section class="hero">
            <div class="hero-inner">
                <div class="hero-copy">
                    <h1>Designed to keep your team moving</h1>
                    <p>Eliminate project chaos with visual workflow tracking, direct task query discussions, and instant team communication in one clean workspace.</p>
                    <div class="hero-actions">
                        @if (isAuthenticated)
                        {
                            <a asp-controller="Project" asp-action="Index" class="btn-solid">
                                <i class="bi bi-kanban"></i> Manage workspaces
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn-solid">
                                Get started <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn-ghost">
                                Sign in
                            </a>
                        }
                    </div>
                </div>

                <div class="hero-board" id="heroBoard" aria-hidden="true">
                    <div class="hero-col">
                        <span class="hero-col-label">TODO · 2</span>
                        <div class="hero-card" id="heroCard1">
                            <span class="tag">WEB-14</span><br>
                            Drag &amp; drop board polish
                        </div>
                        <div class="hero-card">
                            <span class="tag">WEB-09</span><br>
                            Notification badges
                        </div>
                    </div>
                    <div class="hero-col" id="heroColProgress">
                        <span class="hero-col-label">IN PROGRESS · 1</span>
                        <div class="hero-card">
                            <span class="tag">WEB-11</span><br>
                            Workspace member roster
                        </div>
                        <div class="hero-card ghost" id="heroGhost"></div>
                    </div>
                    <div class="hero-col">
                        <span class="hero-col-label">DONE · 1</span>
                        <div class="hero-card">
                            <span class="tag">WEB-02</span><br>
                            Project chat window
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Feature explorer -->
        <div class="explorer-heading">
            <h2>Everything a workspace needs</h2>
            <p>Seven tools that work together, from how you organize a team to how a single task gets discussed and closed out.</p>
        </div>

        <div class="feature-explorer">
            <nav class="feature-index" id="featureIndex">
                <a href="#f-workspaces" class="index-item"><span class="dot"></span>Workspaces &amp; teams</a>
                <a href="#f-filter" class="index-item"><span class="dot"></span>Filter by member</a>
                <a href="#f-mytasks" class="index-item"><span class="dot"></span>Unified my tasks</a>
                <a href="#f-chat" class="index-item"><span class="dot"></span>Team messenger</a>
                <a href="#f-notifications" class="index-item"><span class="dot"></span>Live notifications</a>
                <a href="#f-discussions" class="index-item"><span class="dot"></span>Task discussions</a>
                <a href="#f-archive" class="index-item"><span class="dot"></span>Archiving</a>
            </nav>

            <div class="feature-panels">

                <!-- Workspaces & Team Management -->
                <article id="f-workspaces" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Team hub</span>
                            <h3>Dedicated workspaces &amp; team management</h3>
                            <p class="lede">Organize work by initiative, department, or client into isolated workspaces, and bring team members together with clear access and direct delegation.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span><strong>Member roster:</strong> add teammates to a workspace so everyone knows who's on it.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Project boundary:</strong> keep documents, conversations, and task lists private to designated members.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Direct assignment:</strong> assign owners to deliverables so accountability stays clear.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-card">
                                <div class="mock-row" style="margin-bottom:10px;">
                                    <span class="mock-title"><i class="bi bi-diagram-3-fill" style="color:var(--brand); margin-right:6px;"></i>Workspace</span>
                                    <span class="pill brand">5 members</span>
                                </div>
                                <div class="mock-row" style="margin-bottom:8px;">
                                    <div class="mock-row" style="gap:8px;"><div class="avatar">JD</div><span class="mock-sub">Lead Dev</span></div>
                                    <span class="pill brand">Active</span>
                                </div>
                                <div class="mock-row">
                                    <div class="mock-row" style="gap:8px;"><div class="avatar" style="color:var(--slate); background:var(--slate-soft);">SK</div><span class="mock-sub">Product Lead</span></div>
                                    <span class="pill slate">Member</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Filter by member -->
                <article id="f-filter" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Member focus</span>
                            <h3>Workspace filtering by team member</h3>
                            <p class="lede">Isolate individual workloads in a single click — filter the board by teammate to check progress, balance workload, or focus only on what's yours.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span><strong>One-click isolation:</strong> filter board tasks to show only work assigned to a chosen collaborator.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Workload visibility:</strong> see who's assigned to what, and spot bottlenecks early.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Assigned-to-me view:</strong> strip away noise and see only your personal deliverables.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-row" style="margin-bottom:10px;">
                                <span class="mock-sub">Filter by assignee</span>
                                <span class="pill brand"><i class="bi bi-people-fill"></i> 4</span>
                            </div>
                            <div class="mock-row" style="gap:6px; margin-bottom:14px; flex-wrap:wrap;">
                                <span class="chip">All</span>
                                <span class="chip on"><i class="bi bi-check2"></i> Alex Rivers</span>
                                <span class="chip">Sarah Chen</span>
                            </div>
                            <div class="mock-card accent-brand">
                                <div class="mock-row" style="margin-bottom:6px;">
                                    <span class="pill brand">Assigned to Alex</span>
                                    <i class="bi bi-person-check-fill" style="color:var(--brand);"></i>
                                </div>
                                <div class="mock-title">Implement payment gateway tests</div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Unified My Tasks -->
                <article id="f-mytasks" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag slate">Centralized command</span>
                            <h3>One "My Tasks" board across every workspace</h3>
                            <p class="lede">No more jumping between boards to find what you need today. Your personal board aggregates every task assigned to you, from every workspace, into one cockpit.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span><strong>Cross-project aggregation:</strong> see tasks from Marketing, Engineering, and Operations side by side.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>Workspace tags:</strong> each task clearly shows which workspace it belongs to.</span></li>
                                <li><i class="bi bi-check2"></i><span><strong>One-stop execution:</strong> move cards through Todo, In Progress, and Done without leaving the hub.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual" style="gap:12px;">
                            <div class="mock-card accent-rust">
                                <div class="mock-row" style="margin-bottom:8px;">
                                    <span class="pill" style="background:var(--rust-soft); color:var(--rust);">Brand strategy</span>
                                    <span class="pill" style="background:#F6DEDE; color:#B23A3A;">Todo</span>
                                </div>
                                <div class="mock-title" style="margin-bottom:8px;">Finalize launch assets &amp; banner graphics</div>
                                <div class="mock-row" style="border-top:1px solid var(--border); padding-top:8px;">
                                    <span class="mock-sub"><i class="bi bi-person-circle"></i> You</span>
                                    <span class="mock-sub"><i class="bi bi-chat-text"></i> 2 queries</span>
                                </div>
                            </div>
                            <div class="mock-card accent-slate">
                                <div class="mock-row" style="margin-bottom:8px;">
                                    <span class="pill slate">Web App V2</span>
                                    <span class="pill" style="background:var(--slate-soft); color:var(--slate);">In progress</span>
                                </div>
                                <div class="mock-title" style="margin-bottom:8px;">Implement drag &amp; drop Kanban board</div>
                                <div class="mock-row" style="border-top:1px solid var(--border); padding-top:8px;">
                                    <span class="mock-sub"><i class="bi bi-person-circle"></i> You</span>
                                    <span class="mock-sub"><i class="bi bi-chat-text"></i> 5 queries</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Team Messenger -->
                <article id="f-chat" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Team connection</span>
                            <h3>An instant, floating team messenger</h3>
                            <p class="lede">Stay connected without switching to an external chat app. Coordinate deadlines and discuss tasks directly from a docked chat window while reviewing work.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span>A dedicated conversation space for every project.</span></li>
                                <li><i class="bi bi-check2"></i><span>Real-time message updates, no page reloads.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-card" style="display:flex; flex-direction:column; gap:8px;">
                                <div class="mock-row" style="border-bottom:1px solid var(--border); padding-bottom:8px; margin-bottom:2px;">
                                    <span class="mock-title"><i class="bi bi-circle-fill" style="color:var(--brand); font-size:0.5rem; margin-right:6px;"></i>Project chat</span>
                                </div>
                                <div class="bubble in">Hey, is the draft ready?</div>
                                <div class="bubble out">Just submitted!</div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Notifications -->
                <article id="f-notifications" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag gold">Real-time alerts</span>
                            <h3>Stay on top of what changed</h3>
                            <p class="lede">Get notified the moment a teammate assigns you a task, posts a query, or sends a critical update, so nothing important slips past you.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span>Live badges highlight unread notifications instantly.</span></li>
                                <li><i class="bi bi-check2"></i><span>One-click shortcuts jump straight to the relevant item.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-card">
                                <div class="mock-row" style="margin-bottom:10px;">
                                    <span class="mock-title"><i class="bi bi-bell-fill" style="color:var(--gold); margin-right:6px;"></i>Notification</span>
                                    <span class="pill gold">New</span>
                                </div>
                                <div style="height:6px; background:var(--paper); border-radius:4px; margin-bottom:6px;"></div>
                                <div style="height:6px; width:65%; background:var(--paper); border-radius:4px;"></div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Discussions -->
                <article id="f-discussions" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag slate">Focused communication</span>
                            <h3>In-task question &amp; response threads</h3>
                            <p class="lede">Keep conversations where they belong. Ask questions, clarify requirements, and answer directly inside each task card, so context never gets lost.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span>Dedicated questions with direct team replies.</span></li>
                                <li><i class="bi bi-check2"></i><span>A discussion history attached to every task.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual">
                            <div class="mock-card">
                                <div class="mock-title" style="margin-bottom:10px; color:var(--brand);"><i class="bi bi-chat-left-text-fill"></i>&nbsp; Task query thread</div>
                                <div class="bubble in" style="margin-bottom:8px; max-width:100%;">Which API version should we target?</div>
                                <div class="bubble out" style="max-width:100%; margin-left:0;">Version 2.0 endpoints.</div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- Archiving -->
                <article id="f-archive" class="feature-panel">
                    <div class="panel-grid">
                        <div>
                            <span class="panel-tag brand">Clean workspaces</span>
                            <h3>A clutter-free board via archiving</h3>
                            <p class="lede">Stay focused on active priorities without losing completed records. Archive finished items to keep the workspace tidy while preserving historical access.</p>
                            <ul class="point-list">
                                <li><i class="bi bi-check2"></i><span>Clean, uncluttered task lanes.</span></li>
                                <li><i class="bi bi-check2"></i><span>A quick unarchive option whenever you need the reference.</span></li>
                            </ul>
                        </div>
                        <div class="panel-visual" style="align-items:center;">
                            <div style="width:56px; height:56px; border-radius:50%; background:var(--surface); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--brand); font-size:1.4rem; margin-bottom:10px;">
                                <i class="bi bi-archive-fill"></i>
                            </div>
                            <span class="mock-sub" style="text-align:center;">Organized &amp; stored safely</span>
                        </div>
                    </div>
                </article>

            </div>
        </div>

        <!-- Bottom Authentication & Navigation Section -->
        <section class="cta-section">
            @if (!isAuthenticated)
            {
                <div class="explorer-heading">
                    <h2>Ready to simplify your daily workflow?</h2>
                    <p>Access your existing account, or register in seconds.</p>
                </div>

                <div class="cta-grid">
                    <div class="cta-block signin">
                        <div>
                            <h4>Sign in</h4>
                            <p>Continue managing your active tasks, discussions, and project messages.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn-outline-ink">
                            Enter workspace <i class="bi bi-box-arrow-in-right"></i>
                        </a>
                    </div>

                    <div class="cta-block register">
                        <div>
                            <h4>Create an account</h4>
                            <p>Set up your profile to start creating projects, organizing tasks, and collaborating with teammates.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Register" class="btn-solid">
                            Get started <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="welcome-block">
                    <h4>Welcome back, @User.Identity?.Name</h4>
                    <p>Head straight to your dashboard to review your active priorities.</p>
                    <a asp-controller="Project" asp-action="Index" class="btn-outline-ink">
                        Go to dashboard <i class="bi bi-arrow-right-circle"></i>
                    </a>
                </div>
            }
        </section>

    </div>
</div>

<script>
    (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Highlight the active feature in the index as the user scrolls
        var indexLinks = Array.prototype.slice.call(document.querySelectorAll('#featureIndex .index-item'));
        var panels = Array.prototype.slice.call(document.querySelectorAll('.feature-panel'));

        if (panels.length && 'IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var id = entry.target.getAttribute('id');
                        indexLinks.forEach(function (link) {
                            link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                        });
                    }
                });
            }, { rootMargin: '-20% 0px -65% 0px', threshold: 0 });

            panels.forEach(function (panel) { observer.observe(panel); });
        } else if (indexLinks[0]) {
            indexLinks[0].classList.add('active');
        }

        indexLinks.forEach(function (link) {
            link.addEventListener('click', function (e) {
                var target = document.querySelector(link.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                }
            });
        });

        // One orchestrated hero moment: a card moves from Todo into In Progress
        if (!reduceMotion) {
            var card = document.getElementById('heroCard1');
            var ghost = document.getElementById('heroGhost');
            if (card && ghost) {
                setTimeout(function () {
                    var cardRect = card.getBoundingClientRect();
                    var ghostRect = ghost.getBoundingClientRect();
                    var dx = ghostRect.left - cardRect.left;
                    var dy = ghostRect.top - cardRect.top;
                    card.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
                    card.style.opacity = '0';
                    setTimeout(function () {
                        ghost.classList.remove('ghost');
                        ghost.innerHTML = card.innerHTML;
                        card.style.display = 'none';
                    }, 620);
                }, 1400);
            }
        }
    })();
</script>