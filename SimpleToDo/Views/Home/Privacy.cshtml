@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-page {
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --surface: #FFFFFF;
        --border: #E3E4DE;
        --brand: #1F4D42;
        --brand-dark: #143229;
        --brand-soft: #E7EEEA;
        --rust: #A8501F;
        --rust-soft: #F3E4D8;
        --gold: #B9862B;
        --gold-soft: #F3E9D3;
        --slate: #3E5878;
        --slate-soft: #E5EAF1;
        --danger: #B23A3A;
        --danger-soft: #F6DEDE;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--paper);
        color: var(--ink);
        padding: 40px 0 72px;
    }

        .privacy-page * {
            box-sizing: border-box;
        }

        .privacy-page h1, .privacy-page h5, .privacy-page h6 {
            color: var(--ink);
            margin: 0;
        }

        .privacy-page p, .privacy-page span, .privacy-page li {
            color: var(--ink-soft);
        }

    /* Header */
    .privacy-header-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 36px 32px;
        position: relative;
        overflow: hidden;
    }

        .privacy-header-card::before {
            content: "";
            position: absolute;
            top: -60px;
            right: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: var(--brand-soft);
            z-index: 0;
        }

        .privacy-header-card > .d-flex {
            position: relative;
            z-index: 1;
        }

        .privacy-header-card h1 {
            font-size: 1.9rem;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .privacy-header-card p {
            font-size: 0.9rem;
        }

    .updated-pill {
        background: var(--brand-soft);
        color: var(--brand);
        border: 1px solid var(--brand-soft);
        border-radius: 999px;
        padding: 9px 18px;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
    }

        .updated-pill i {
            margin-right: 6px;
        }

    /* Sticky Nav */
    .nav-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 16px;
    }

        .nav-card h6 {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--ink-soft);
            letter-spacing: 0.03em;
            padding: 0 10px;
            margin-bottom: 10px;
        }

    .quick-nav-link {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 9px 12px;
        color: var(--ink-soft);
        font-size: 0.86rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: 10px;
        border-left: 2px solid transparent;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

        .quick-nav-link i {
            color: var(--ink-soft);
            font-size: 0.95rem;
            transition: color 0.15s ease;
        }

        .quick-nav-link:hover,
        .quick-nav-link.active {
            background: var(--brand-soft);
            color: var(--brand);
            border-left-color: var(--brand);
        }

            .quick-nav-link:hover i,
            .quick-nav-link.active i {
                color: var(--brand);
            }

    /* Policy cards */
    .policy-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px;
        scroll-margin-top: 20px;
        transition: border-color 0.2s ease;
    }

        .policy-card:hover {
            border-color: #CBCDC5;
        }

    .policy-icon-wrapper {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
        background: var(--brand-soft);
        color: var(--brand);
    }

        .policy-icon-wrapper.rust {
            background: var(--rust-soft);
            color: var(--rust);
        }

        .policy-icon-wrapper.slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

        .policy-icon-wrapper.gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .policy-icon-wrapper.ink {
            background: #EDEEEA;
            color: var(--ink);
        }

    .policy-card h5 {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .policy-card .eyebrow {
        font-size: 0.8rem;
        color: var(--ink-soft);
    }

    .policy-card p.lede {
        font-size: 0.88rem;
        line-height: 1.6;
    }

    /* Info pill cards */
    .info-pill-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 20px;
        height: 100%;
    }

    .info-icon-badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--brand);
    }

    .info-pill-card h6 {
        font-size: 0.92rem;
        font-weight: 700;
    }

    .info-pill-card p {
        font-size: 0.84rem;
        line-height: 1.55;
        margin: 0;
    }

    /* Bulleted list */
    .policy-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .policy-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 0.87rem;
            line-height: 1.55;
        }

            .policy-list li strong {
                color: var(--ink);
            }

        .policy-list i {
            color: var(--brand);
            margin-top: 3px;
            flex-shrink: 0;
        }

    /* Callout */
    .callout {
        background: var(--slate-soft);
        border-left: 3px solid var(--slate);
        border-radius: 10px;
        padding: 14px 16px;
    }

        .callout p {
            font-size: 0.86rem;
            margin: 0;
        }

        .callout strong {
            color: var(--ink);
        }

    /* Storage safeguards */
    .safeguard-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.87rem;
        line-height: 1.55;
    }

        .safeguard-row i {
            color: var(--brand);
            margin-top: 3px;
        }

        .safeguard-row strong {
            color: var(--ink);
        }

    .contact-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--brand-soft);
        color: var(--brand);
        border: 1px solid var(--brand-soft);
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 0.86rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s ease;
    }

        .contact-btn:hover {
            background: #DCE6E0;
            color: var(--brand-dark);
        }

    @@media (max-width: 991px) {
        .privacy-header-card {
            padding: 28px 22px;
        }

        .policy-card {
            padding: 22px;
        }
    }
</style>

<div class="privacy-page">
    <div class="container">

        <!-- Header Section -->
        <div class="privacy-header-card mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <h1>Privacy Policy</h1>
                    <p class="mb-0 mt-1">Learn how we handle, protect, and isolate your personal and workspace information.</p>
                </div>
                <div class="updated-pill">
                    <i class="bi bi-clock-history"></i>Last updated: September 2026
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sticky Navigation Index (Desktop) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="nav-card sticky-top" style="top: 20px;" id="privacyNav">
                    <h6>Policy sections</h6>
                    <nav class="d-flex flex-column gap-1">
                        <a href="#collection" class="quick-nav-link"><i class="bi bi-shield-check"></i>Information collected</a>
                        <a href="#usage" class="quick-nav-link"><i class="bi bi-diagram-3"></i>Data usage</a>
                        <a href="#realtime" class="quick-nav-link"><i class="bi bi-chat-dots"></i>Real-time messages</a>
                        <a href="#storage" class="quick-nav-link"><i class="bi bi-lock"></i>Storage &amp; security</a>
                        <a href="#rights" class="quick-nav-link"><i class="bi bi-person-check"></i>User rights &amp; control</a>
                        <a href="#contact" class="quick-nav-link"><i class="bi bi-envelope"></i>Contact support</a>
                    </nav>
                </div>
            </div>

            <!-- Policy Content Sections -->
            <div class="col-lg-9 d-flex flex-column gap-4">

                <!-- Section 1: Information Collection -->
                <div class="policy-card" id="collection">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <h5>1. Information we collect</h5>
                            <span class="eyebrow">Account metadata and workspace interaction records</span>
                        </div>
                    </div>
                    <p class="lede mb-3">
                        To deliver collaborative task planning and project workflows, we collect minimal information necessary for identification and state synchronization:
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-pill-card">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="info-icon-badge"><i class="bi bi-person-badge"></i></div>
                                    <h6 class="mb-0">Account credentials</h6>
                                </div>
                                <p>Full name, email address, and encrypted identity security tokens required for authentication.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-pill-card">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="info-icon-badge"><i class="bi bi-kanban"></i></div>
                                    <h6 class="mb-0">Workspace artifacts</h6>
                                </div>
                                <p>Tasks, statuses, discussion queries, project group associations, and user-generated notes.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: How Data is Used -->
                <div class="policy-card" id="usage">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper rust"><i class="bi bi-diagram-3"></i></div>
                        <div>
                            <h5>2. How we use your data</h5>
                            <span class="eyebrow">Purposes focused strictly on task organization</span>
                        </div>
                    </div>
                    <p class="lede mb-2">Your data is strictly used to operate and improve workspace productivity features:</p>
                    <ul class="policy-list">
                        <li><i class="bi bi-check2"></i><span><strong>Task orchestration:</strong> persisting workflow changes across visual Kanban board stages (Todo, In Progress, Done).</span></li>
                        <li><i class="bi bi-check2"></i><span><strong>Event notifications:</strong> dispatching notifications when you receive task assignments or discussion replies.</span></li>
                        <li><i class="bi bi-check2"></i><span><strong>Access enforcement:</strong> ensuring project documents and chat feeds are strictly visible only to assigned team members.</span></li>
                    </ul>
                </div>

                <!-- Section 3: Real-Time Messaging & Chat Feeds -->
                <div class="policy-card" id="realtime">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper slate"><i class="bi bi-chat-dots"></i></div>
                        <div>
                            <h5>3. Real-time communication &amp; chat data</h5>
                            <span class="eyebrow">Channel privacy for team dialogues</span>
                        </div>
                    </div>
                    <p class="lede mb-3">
                        Floating project chats operate over secure real-time connections. Messages are stored to provide persistent conversation history across your team's browser sessions.
                    </p>
                    <div class="callout">
                        <p><strong>Channel isolation guarantee:</strong> project conversations and task discussion threads are never made public or exposed outside the explicitly designated project members.</p>
                    </div>
                </div>

                <!-- Section 4: Data Storage & Security -->
                <div class="policy-card" id="storage">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper gold"><i class="bi bi-lock"></i></div>
                        <div>
                            <h5>4. Storage &amp; security safeguards</h5>
                            <span class="eyebrow">Encrypted transmission and safe record retention</span>
                        </div>
                    </div>
                    <p class="lede mb-2">We maintain modern technical safeguards to defend your credentials and collaborative records:</p>
                    <div class="d-flex flex-column gap-2">
                        <div class="safeguard-row">
                            <i class="bi bi-shield-lock"></i>
                            <span><strong>In-transit encryption:</strong> all requests, hub connections, and data transfers are protected using HTTPS and TLS protocols.</span>
                        </div>
                        <div class="safeguard-row">
                            <i class="bi bi-key"></i>
                            <span><strong>Credential protection:</strong> passwords and sensitive authenticators are hashed using industry-standard cryptographic algorithms.</span>
                        </div>
                    </div>
                </div>

                <!-- Section 5: User Rights & Data Control -->
                <div class="policy-card" id="rights">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper"><i class="bi bi-person-check"></i></div>
                        <div>
                            <h5>5. Your control &amp; privacy rights</h5>
                            <span class="eyebrow">Management of your tasks and workspace footprint</span>
                        </div>
                    </div>
                    <p class="lede mb-3">You have complete control over the information you introduce into the platform:</p>
                    <ul class="policy-list">
                        <li><i class="bi bi-check2"></i><span><strong>Archiving &amp; deletion:</strong> archive finished items at any time, or unarchive them from your history.</span></li>
                        <li><i class="bi bi-check2"></i><span><strong>Profile modifications:</strong> update your display name, contact email, or credential details through account settings.</span></li>
                        <li><i class="bi bi-check2"></i><span><strong>Zero data selling:</strong> we never sell, monetize, or rent personal workspace data to advertising networks.</span></li>
                    </ul>
                </div>

                <!-- Section 6: Contact & Inquiries -->
                <div class="policy-card" id="contact">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="policy-icon-wrapper ink"><i class="bi bi-envelope"></i></div>
                        <div>
                            <h5>6. Questions &amp; privacy support</h5>
                            <span class="eyebrow">Direct assistance regarding your information</span>
                        </div>
                    </div>
                    <p class="lede mb-3">
                        If you have questions regarding this Privacy Policy, your account data, or security concerns, contact our platform administrators:
                    </p>
                    <a href="mailto:support@simpletodo.local" class="contact-btn">
                        <i class="bi bi-envelope-at"></i>support@simpletodo.local
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var navLinks = Array.prototype.slice.call(document.querySelectorAll('#privacyNav .quick-nav-link'));
        var sections = Array.prototype.slice.call(document.querySelectorAll('.policy-card[id]'));

        if (sections.length && 'IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var id = entry.target.getAttribute('id');
                        navLinks.forEach(function (link) {
                            link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                        });
                    }
                });
            }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });

            sections.forEach(function (section) { observer.observe(section); });
        }

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        navLinks.forEach(function (link) {
            link.addEventListener('click', function (e) {
                var target = document.querySelector(link.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                }
            });
        });
    })();
</script>