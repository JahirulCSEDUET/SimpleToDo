@model IReadOnlyList<ToDoItemListViewModel>

@{
    ViewData["Title"] = "My To-Do List";
}

<div class="container mt-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Tasks</h2>
        <a asp-action="Create" class="btn btn-primary">Add New Task</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You don't have any tasks right now. Click "Add New Task" to get started!
        </div>
    }
    else
    {
        <div class="todo-list">
            @foreach (var item in Model)
            {
                <div class="card mb-3 shadow-sm border-0 bg-light">
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        
                        <div>
                            <h5 class="mb-1 text-dark fw-bold">@item.Title</h5>
                            <span class="text-muted small d-block">
                                Status: <strong>@item.Status</strong>
                            </span>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            
                            <!-- Conditional Action Button based on Status -->
                            @if (item.Status.ToString() == "Pending")
                            {
                                <form asp-action="UpdateStatus" asp-controller="ToDo" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Processing" />
                                    <button type="submit" class="btn btn-primary btn-sm">Process it</button>
                                </form>
                            }
                            else if (item.Status.ToString() == "Processing")
                            {
                                <form asp-action="UpdateStatus" asp-controller="ToDo" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <button type="submit" class="btn btn-success btn-sm">Mark As Complete</button>
                                </form>
                            }
                            else if(item.Status.ToString() == "Completed")
                            {
                                <button type="button" class="btn btn-success btn-sm">Completed</button>
                            }

                            <!-- Delete Button (Always Visible) -->
                            <form asp-action="Delete" asp-controller="ToDo" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>