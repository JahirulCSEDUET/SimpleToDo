@model IReadOnlyList<ToDoItemListViewModel>

@{
    ViewData["Title"] = "My To-Do List";
}

<!-- Dynamic Style Overrides for Advanced UI Feel -->
<style>
    .kanban-column {
        min-height: 550px;
        background-color: rgba(248, 249, 250, 0.7);
        border: 1px dashed #dee2e6;
        border-radius: 16px;
        padding: 16px;
        transition: background-color 0.2s ease;
    }

    .sortable-ghost {
        opacity: 0.3;
        transform: scale(0.98);
        filter: grayscale(1);
    }

    .task-card {
        cursor: grab;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .task-card:active {
            cursor: grabbing;
        }

        .task-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }

    .line-clamp-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="container mt-4">
    <!-- Board Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 pb-3 border-bottom">
        <div>
            <h2 class="mb-1 fw-bold text-dark tracking-tight">My Tasks Board</h2>
            <p class="text-muted mb-0 small">Drag and drop cards to update status phases seamlessly.</p>
        </div>
        <div class="d-flex gap-2 w-100 w-sm-auto">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm d-flex align-items-center gap-2 btn-sm py-2">
                <i class="bi bi-plus-lg fs-6"></i> New Task
            </a>
            <a asp-action="ArchivedList" class="btn btn-light border rounded-pill px-3 text-secondary d-flex align-items-center gap-2 btn-sm py-2" title="Archived List">
                <i class="bi bi-archive"></i> Archived
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border border-dashed rounded-4 p-5 text-center bg-light bg-opacity-20">
            <div class="bg-light text-secondary rounded-circle d-inline-flex justify-content-center align-items-center mb-3 shadow-sm" style="width: 64px; height: 64px;">
                <i class="bi bi-clipboard-check fs-3 text-primary"></i>
            </div>
            <h5 class="fw-bold text-dark">Your board is empty</h5>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 340px;">No task assignments found. Start mapping out your workflow objectives.</p>
            <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm">Add New Task</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- LANE 1: TODO -->
            <div class="col-xl-4 col-lg-4">
                <div class="card border-0 bg-transparent mb-4">
                    <div class="card-body p-0 d-flex align-items-center justify-content-between mb-3 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-block bg-secondary bg-opacity-20 rounded-circle" style="width: 10px; height: 10px;"></span>
                            <h5 class="fw-bold text-dark mb-0">Todo</h5>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5">
                            @Model.Count(m => m.Status.ToString() == "Pending")
                        </span>
                    </div>
                    <div class="kanban-column" id="Pending" data-status="Pending">
                        @foreach (var item in Model.Where(m => m.Status.ToString() == "Pending"))
                        {
                            <partial name="_TaskCardPartial" model="item" />
                        }
                    </div>
                </div>
            </div>

            <!-- LANE 2: IN PROGRESS -->
            <div class="col-xl-4 col-lg-4">
                <div class="card border-0 bg-transparent mb-4">
                    <div class="card-body p-0 d-flex align-items-center justify-content-between mb-3 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-block bg-primary rounded-circle" style="width: 10px; height: 10px;"></span>
                            <h5 class="fw-bold text-dark mb-0">In Progress</h5>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5">
                            @Model.Count(m => m.Status.ToString() == "Processing")
                        </span>
                    </div>
                    <div class="kanban-column shadow-sm" id="Processing" data-status="Processing" style="background-color: rgba(13, 110, 253, 0.02); border-color: rgba(13, 110, 253, 0.15);">
                        @foreach (var item in Model.Where(m => m.Status.ToString() == "Processing"))
                        {
                            <partial name="_TaskCardPartial" model="item" />
                        }
                    </div>
                </div>
            </div>

            <!-- LANE 3: DONE -->
            <div class="col-xl-4 col-lg-4">
                <div class="card border-0 bg-transparent mb-4">
                    <div class="card-body p-0 d-flex align-items-center justify-content-between mb-3 px-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-block bg-success rounded-circle" style="width: 10px; height: 10px;"></span>
                            <h5 class="fw-bold text-dark mb-0">Done</h5>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">
                            @Model.Count(m => m.Status.ToString() == "Completed")
                        </span>
                    </div>
                    <div class="kanban-column" id="Completed" data-status="Completed">
                        @foreach (var item in Model.Where(m => m.Status.ToString() == "Completed"))
                        {
                            <partial name="_TaskCardPartial" model="item" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Injection of Script Framework -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const columns = ['Pending', 'Processing', 'Completed'];

        columns.forEach(colId => {
        const el = document.getElementById(colId);
        if (el) {
        new Sortable(el, {
        group: 'todo-board',
        animation: 180,
        ghostClass: 'sortable-ghost',
        handle: '.drag-handle', // Enforces professional handle usage
        fallbackTolerance: 3,

        onEnd: function (evt) {
        if (evt.from === evt.to) return;
        const itemEl = evt.item;
        const taskId = itemEl.getAttribute('data-id');
        const newStatus = evt.to.getAttribute('data-status');

        updateTaskStatus(taskId, newStatus, evt.from, evt.item);
        }
        });
        }
        });

        function updateTaskStatus(taskId, newStatus, oldColumn, itemElement) {
        let formData = new FormData();
        formData.append('id', taskId);
        formData.append('status', newStatus);

        fetch('/ToDo/UpdateStatus', {
        method: 'POST',
        body: formData
        })
        .then(response => {
        if (response.ok || response.redirected) {
        const archiveForm = itemElement.querySelector('.archive-form');
        if (archiveForm) {
        if (newStatus === 'Completed') {
        archiveForm.classList.remove('d-none');
        } else {
        archiveForm.classList.add('d-none');
        }
        }
        } else {
        alert('Error updating status.');
        oldColumn.appendChild(itemElement);
        }
        })
        .catch(error => {
        console.error('Error:', error);
        oldColumn.appendChild(itemElement);
        });
        }
        });
    </script>
}