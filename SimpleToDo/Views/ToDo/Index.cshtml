@model IReadOnlyList<ToDoItemListViewModel>

@{
    ViewData["Title"] = "My To-Do List";
}

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<style>
    .kanban-column {
    min-height: 300px;
    background-color: #f8f9fa;
    border-radius: 8px;
    padding: 10px;
    }

    .sortable-ghost {
    opacity: 0.4;
    background-color: #e9ecef;
    }

    .task-card {
    cursor: grab;
    }

    .task-card:active {
    cursor: grabbing;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        
        <!-- Title on the LEFT -->
        <h2 class="mb-0">My Tasks Board</h2>

        <!-- Buttons grouped together on the RIGHT -->
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary" title="Create a new task">
                <i class="bi bi-plus-circle"></i> <!-- Added text back if you want it -->
            </a>
            <a asp-action="ArchivedList" class="btn btn-secondary" title="Archived List">
                <i class="bi bi-archive"></i>
            </a>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You don't have any tasks right now. Click <a asp-action="Create" >"Add New Task"</a> to get started!
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <h4 class="text-center text-secondary mb-3">Todo</h4>
                <div class="kanban-column" id="Pending" data-status="Pending">
                    @foreach (var item in Model.Where(m => m.Status.ToString() == "Pending"))
                    {
                        <partial name="_TaskCardPartial" model="item" />
                    }
                </div>
            </div>

            <div class="col-md-4">
                <h4 class="text-center text-primary mb-3">In Progress</h4>
                <div class="kanban-column" id="Processing" data-status="Processing">
                    @foreach (var item in Model.Where(m => m.Status.ToString() == "Processing"))
                    {
                        <partial name="_TaskCardPartial" model="item" />
                    }
                </div>
            </div>

            <div class="col-md-4">
                <h4 class="text-center text-success mb-3">Done</h4>
                <div class="kanban-column" id="Completed" data-status="Completed">
                    @foreach (var item in Model.Where(m => m.Status.ToString() == "Completed"))
                    {
                        <partial name="_TaskCardPartial" model="item" />
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const columns = ['Pending', 'Processing', 'Completed'];

            columns.forEach(colId => {
                const el = document.getElementById(colId);
                if (el) {
                    new Sortable(el, {
                        group: 'todo-board',
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        
                        onEnd: function (evt) {
                            if (evt.from === evt.to) return;
                            const itemEl = evt.item;
                            const taskId = itemEl.getAttribute('data-id');
                            const newStatus = evt.to.getAttribute('data-status');

                            updateTaskStatus(taskId, newStatus, evt.from, evt.item);
                        }
                    });
                }
            });

            function updateTaskStatus(taskId, newStatus, oldColumn, itemElement) {
                
                let formData = new FormData();
                formData.append('id', taskId);
                formData.append('status', newStatus);

                fetch('/ToDo/UpdateStatus', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    // Check if the backend update succeeded
                    if (response.ok || response.redirected) {
                        
                        // NEW CODE: Find the form inside the dragged card
                        const archiveForm = itemElement.querySelector('.archive-form');
                        
                        if (archiveForm) {
                            if (newStatus === 'Completed') {
                                archiveForm.classList.remove('d-none'); // Show button
                            } 
                            else {
                                archiveForm.classList.add('d-none'); // Hide button if dragged out
                            }
                        }

                    } 
                    else {
                        alert('Error updating status.');
                        oldColumn.appendChild(itemElement);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    oldColumn.appendChild(itemElement);
                });
            }
        });
    </script>
}