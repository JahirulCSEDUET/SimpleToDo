@model IReadOnlyList<ToDoItemListViewModel>

@{
    ViewData["Title"] = "Archived Tasks";
}

<style>
    .archive-page {
        --ink: #171B21;
        --ink-soft: #565F6B;
        --paper: #F7F7F4;
        --surface: #FFFFFF;
        --border-c: #E3E4DE;
        --brand: #1F4D42;
        --brand-dark: #143229;
        --brand-soft: #E7EEEA;
        --rust: #A8501F;
        --rust-soft: #F3E4D8;
    }

        .archive-page * {
            box-sizing: border-box;
        }

        .archive-page h2, .archive-page h5, .archive-page h6 {
            color: var(--ink);
        }

    .archive-header {
        border-bottom: 1px solid var(--border-c);
    }

        .archive-header h2 {
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }

    .archive-header-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--brand-soft);
        color: var(--brand);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--surface);
        border: 1px solid var(--border-c);
        color: var(--ink-soft);
        border-radius: 999px;
        padding: 9px 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .back-btn:hover {
            background: var(--brand-soft);
            border-color: var(--brand-soft);
            color: var(--brand);
        }

    /* Empty state */
    .archive-empty {
        background: var(--surface);
        border: 1.5px dashed var(--border-c);
        border-radius: 18px;
        padding: 48px 24px;
        text-align: center;
    }

    .archive-empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--paper);
        border: 1px solid var(--border-c);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: var(--ink-soft);
        margin-bottom: 14px;
    }

    .archive-empty h5 {
        font-size: 1.02rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .archive-empty p {
        color: var(--ink-soft);
        font-size: 0.85rem;
        max-width: 340px;
        margin: 0 auto;
    }

    /* Data container */
    .archive-table-card {
        background: var(--surface);
        border: 1px solid var(--border-c);
        border-radius: 18px;
        overflow: hidden;
    }

    .archive-table-header {
        background: var(--paper);
        border-bottom: 1px solid var(--border-c);
        padding: 14px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .archive-table-header span.label {
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            color: var(--ink-soft);
        }

    .archive-total-badge {
        font-size: 0.76rem;
        font-weight: 700;
        background: var(--brand-soft);
        color: var(--brand);
        border-radius: 999px;
        padding: 4px 12px;
    }

    .archive-row {
        padding: 22px 24px;
        border-bottom: 1px solid var(--border-c);
        transition: background 0.15s ease;
    }

        .archive-row:last-child {
            border-bottom: none;
        }

        .archive-row:hover {
            background: var(--paper);
        }

    .archive-item-title {
        font-weight: 600;
        color: var(--ink-soft);
        text-decoration: line-through;
        max-width: 500px;
    }

    .archived-chip {
        font-size: 0.7rem;
        font-weight: 700;
        background: var(--rust-soft);
        color: var(--rust);
        border-radius: 999px;
        padding: 2px 10px;
    }

    .archive-meta {
        font-size: 0.8rem;
        color: var(--ink-soft);
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .archive-meta i {
            color: var(--brand);
        }

        .archive-meta strong {
            color: var(--ink);
            font-weight: 600;
        }

    .archive-meta-sep {
        color: var(--border-c);
    }

    .personal-task-label {
        font-size: 0.8rem;
        color: var(--ink-soft);
        font-style: italic;
    }

    .restore-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--brand-soft);
        color: var(--brand);
        border: 1px solid var(--brand-soft);
        border-radius: 999px;
        padding: 6px 16px;
        font-size: 0.83rem;
        font-weight: 600;
        transition: background 0.15s ease;
    }

        .restore-btn:hover {
            background: var(--brand);
            color: #fff;
        }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        color: var(--rust);
        border: none;
        padding: 6px 10px;
        font-size: 0.83rem;
        font-weight: 600;
        opacity: 0.8;
        transition: opacity 0.15s ease;
    }

        .delete-btn:hover {
            opacity: 1;
        }

    @@media (max-width: 767px) {
        .archive-row {
            padding: 18px;
        }
    }
</style>

<div class="archive-page">
    <div class="container mt-4">
        <!-- View Header -->
        <div class="archive-header d-flex justify-content-between align-items-center gap-3 mb-5 pb-3">
            <h2>
                <span class="archive-header-icon"><i class="bi bi-archive"></i></span>Archived tasks
            </h2>
            <a asp-action="Index" class="back-btn" title="Go back to the main task board">
                <i class="bi bi-arrow-left"></i> Back to board
            </a>
        </div>

        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="archive-empty">
                <div class="archive-empty-icon"><i class="bi bi-inbox-fill"></i></div>
                <h5>Archive is clean</h5>
                
            </div>
        }
        else
        {
            <!-- Data Container -->
            <div class="archive-table-card">
                <div class="archive-table-header">
                    <span class="label">Task profile details</span>
                    <span class="archive-total-badge">Total: @Model.Count</span>
                </div>

                <div>
                    @foreach (var item in Model)
                    {
                        <div class="archive-row">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                                <!-- Left Content Area -->
                                <div class="text-truncate">
                                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                        <h6 class="archive-item-title mb-0 text-truncate d-inline-block" title="@item.Title">
                                            @item.Title
                                        </h6>
                                        <span class="archived-chip">Archived</span>
                                    </div>

                                    <!-- Metadata Row -->
                                    @if (item.ProjectId.HasValue && item.ProjectId != 0)
                                    {
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <span class="archive-meta">
                                                <i class="bi bi-folder2"></i>
                                                Project: <strong>@item.ProjectName</strong>
                                            </span>
                                            <span class="archive-meta-sep d-none d-sm-inline">|</span>
                                            <span class="archive-meta">
                                                <i class="bi bi-person"></i>
                                                By: <strong>@item.CreatorName</strong>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="personal-task-label">Personal task</span>
                                    }
                                </div>

                                <!-- Right Actions Area -->
                                <div class="shrink-0">
                                    <div class="d-flex align-items-center gap-2">

                                        <!-- 1. Restore Action Button -->
                                        <form asp-action="ArchivedUnArchived" asp-controller="ToDo" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="restore-btn" title="Restore this task back to the board">
                                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                                            </button>
                                        </form>

                                        <!-- 2. Permanent Delete Action Button -->
                                        <form asp-action="Delete" asp-controller="ToDo" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to permanently delete this task? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="delete-btn" title="Permanently delete this task">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </form>

                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>