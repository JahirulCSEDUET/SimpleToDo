@model ToDoItemListViewModel

<div class="card mb-3 shadow-sm border border-light-subtle rounded-3 bg-white task-card" data-id="@Model.Id">
    <!-- Top Left Accent Line depending on task metadata conditions -->
    <div class="card-body p-3">

        <!-- Header Content -->
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <div class="d-flex align-items-start gap-2 text-truncate">
                <!-- Drag Grip Icon Handle -->
                <div class="drag-handle text-muted-opacity pt-0.5 px-1 style-pointer" style="cursor: grab;">
                    <i class="bi bi-grip-vertical fs-5 text-secondary text-opacity-50"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="mb-0 fw-bold text-dark text-wrap line-clamp-title lh-base" title="@Model.Title">
                        @Model.Title
                    </h6>
                </div>
            </div>

            <!-- Contextual Actions Box (Archive Form) -->
            <form asp-action="ArchivedUnArchived" asp-controller="ToDo" method="post" class="m-0 archive-form shrink-0 @(Model.Status.ToString() == "Completed" ? "" : "d-none")">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-link text-danger p-0 border-0 text-decoration-none btn-sm d-flex align-items-center gap-1 opacity-75 hover-opacity-100" title="Archive Task">
                    <i class="bi bi-archive-fill"></i> <span class="d-none d-xl-inline font-xs">Archive</span>
                </button>
            </form>
        </div>

        <!-- Task Metadata/Tags Section Footer -->
        @if (Model.ProjectId.HasValue && Model.ProjectId != 0)
        {
            <div class="pt-2.5 mt-2 border-top border-light d-flex flex-column gap-1.5">
                <!-- Project Tag Badge -->
                <div class="d-flex align-items-center gap-1.5 text-truncate">
                    <i class="bi bi-folder2 text-primary small"></i>
                    <span class="text-muted text-truncate" style="font-size: 0.8rem;" title="Project">
                        <span class="fw-medium text-dark-subtle">@Model.ProjectName</span>
                    </span>
                </div>

                <!-- Owner Tag Badge -->
                <div class="d-flex align-items-center gap-1.5 text-truncate">
                    <i class="bi bi-person text-secondary small"></i>
                    <span class="text-muted text-truncate" style="font-size: 0.8rem;" title="Creator">
                        <span class="text-secondary">@Model.CreatorName</span>
                    </span>
                </div>
            </div>
        }
    </div>
</div>