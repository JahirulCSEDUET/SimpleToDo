@model SimpleToDo.Web.ViewModels.ToDo.ToDoItemListViewModel

<div class="card mb-3 shadow-sm border-0 bg-white task-card" data-id="@Model.Id">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
            
            <div>
                <h5 class="mb-1 text-dark fw-bold">@Model.Title</h5>
            </div>
            @if (Model.Status.ToString() == "Completed")
            {
                <form asp-action="Archived" asp-controller="ToDo" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this task?');">
                    <input type="hidden" name="id" value="@Model.Id" />

                
                    <button type="submit" class="btn btn-outline-danger btn-sm border-0">
                        <i class="bi bi-trash"></i> Archive
                    </button>
                                   
                </form>
            }            

        </div>
    </div>
</div>