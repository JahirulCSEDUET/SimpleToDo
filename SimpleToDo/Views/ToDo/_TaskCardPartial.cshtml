@model TodoDto

<style>
    /* Premium AuraSpace Miniature Task Card Design Framework Tokens */
    .task-card-premium {
        cursor: grab;
        border: 1px solid rgba(0, 0, 0, 0.06) !important;
        border-radius: 14px !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .task-card-premium:active {
            cursor: grabbing;
        }

        .task-card-premium:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.6rem 1.2rem rgba(13, 110, 253, 0.05) !important;
            border-color: rgba(13, 110, 253, 0.15) !important;
        }

    .line-clamp-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .meta-label-xs {
        font-size: 0.76rem;
        font-weight: 500;
    }

    .query-badge-pill {
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
        background-color: #f8f9fa;
        border: 1px solid #e3e6f0;
        transition: all 0.15s ease-in-out;
    }

    .task-card-premium:hover .query-badge-pill {
        background-color: rgba(13, 110, 253, 0.03);
        border-color: rgba(13, 110, 253, 0.12);
        color: #0d6efd !important;
    }

    .btn-badge-details {
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 50rem;
        transition: all 0.15s ease-in-out;
        text-decoration: none;
    }

        .btn-badge-details:hover {
            background-color: #0d6efd !important;
            color: #fff !important;
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.12);
        }
</style>

<div class="card mb-3 shadow-sm bg-white task-card-premium" data-id="@Model.Id">
    <div class="card-body p-3">

        <div class="d-flex justify-content-between align-items-start gap-2 mb-2.5">
            <div class="d-flex align-items-start gap-1 flex-grow-1 text-truncate">
                <div class="drag-handle text-muted pt-0.5 px-1 shrink-0">
                    <i class="bi bi-grip-vertical fs-5 text-secondary text-opacity-40"></i>
                </div>

                <div class="text-truncate">
                    <h6 class="mb-0 fw-bold text-dark text-wrap line-clamp-title lh-base small" style="letter-spacing: -0.1px;" title="@Model.Title">
                        @Model.Title
                    </h6>
                </div>
            </div>

            <form asp-action="ArchivedUnArchived" asp-controller="ToDo" method="post" class="m-0 archive-form shrink-0 @(Model.Status.ToString() == "Completed" ? "" : "d-none")">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-link text-danger p-0 border-0 text-decoration-none opacity-50 hover-opacity-100 transition-all" title="Archive Completed Element">
                    <i class="bi bi-archive-fill fs-6"></i>
                </button>
            </form>
        </div>

        @if (Model.ProjectId != 0)
        {
            <div class="mb-3 d-flex flex-column gap-1">
                <div class="d-flex align-items-center gap-2 text-truncate">
                    <i class="bi bi-folder2 text-primary text-opacity-75 shrink-0" style="font-size: 0.85rem;"></i>
                    <span class="text-muted text-truncate meta-label-xs">
                        <span class="text-dark-subtle fw-semibold">@Model.ProjectName</span>
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2 text-truncate">
                    <i class="bi bi-person-circle text-secondary text-opacity-60 shrink-0" style="font-size: 0.85rem;"></i>
                    <span class="text-muted text-truncate meta-label-xs">
                        <span class="text-secondary">@Model.CreatorName</span>
                    </span>
                </div>
            </div>
        }

        <div class="pt-2.5 border-top border-light-subtle d-flex align-items-center justify-content-between gap-2">

            <span class="badge text-secondary rounded-pill d-inline-flex align-items-center gap-1.5 query-badge-pill" title="Discussion thread responses matching task parameters">
                <i class="bi bi-chat-left-text-fill text-muted text-opacity-40" style="font-size: 0.74rem;"></i>
                <span>@Model.QueryList.Count()</span>
            </span>

            <a asp-controller="ToDo"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn-badge-details btn btn-light text-secondary bg-light-subtle border border-light-subtle shadow-none d-inline-flex align-items-center gap-1"
               title="Open collaborative workspace query thread details">
                Details <i class="bi bi-arrow-right small text-opacity-70"></i>
            </a>

        </div>

    </div>
</div>